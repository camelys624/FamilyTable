<view class="page-shell design-page recipe-page">
  <view class="design-hero"><view class="design-copy"><text class="eyebrow">全家共有 · {{recipes.length}} 道</text><view class="page-title">传家的菜谱簿</view><text class="design-note">记下家常味道，让三餐更有滋味。</text></view><view class="hero-picture"><kitchen-art kind="book" art-size="hero-illustration" size="228" /></view></view>
  <button class="primary-button add-recipe-button" bindtap="addRecipe">＋ 记一道</button>
  <view class="cloud-error-card paper-card" wx:if="{{loadError}}"><text class="cloud-error-title">菜谱暂时没加载出来</text><text class="cloud-error-message">{{loadError}}</text><button class="secondary-button cloud-error-retry" bindtap="retryLoad">重新加载</button></view>
  <view class="search-box"><view class="search-icon"></view><input value="{{keyword}}" bindinput="onSearch" placeholder="搜菜名，例如番茄" placeholder-class="search-placeholder" /></view>
  <scroll-view scroll-x class="category-scroll" show-scrollbar="{{false}}"><view class="category-list"><view wx:for="{{categories}}" wx:key="*this" class="category-pill {{selectedCategory === item ? 'active' : ''}}" data-category="{{item}}" bindtap="selectCategory">{{item}}</view></view></scroll-view>
  <view class="design-empty paper-card" wx:if="{{loading}}"><kitchen-art kind="book" size="230" /><text class="subtle">正在翻开家庭菜谱簿…</text></view>
  <view class="recipe-grid" wx:elif="{{visibleRecipes.length}}"><view wx:for="{{visibleRecipes}}" wx:key="id" class="recipe-card paper-card" data-id="{{item.id}}" bindtap="showRecipe"><view class="recipe-cover"><image wx:if="{{item.imagePath}}" class="recipe-cover-image" src="{{item.imagePath}}" mode="aspectFill" /><kitchen-art wx:else name="{{item.name}}" art-size="cover-illustration" size="248" /></view><view class="recipe-body"><text class="recipe-card-title">{{item.name}}</text><text class="recipe-time">{{item.duration}} 分钟</text><view class="recipe-card-meta">{{item.category}} · {{item.difficulty}}</view><text class="recipe-note">{{item.note}}</text></view></view></view>
  <view class="design-empty paper-card" wx:elif="{{!loadError}}"><kitchen-art kind="book" art-size="empty-illustration" size="230" /><text class="section-title">{{recipes.length ? '还没找到这道菜' : '记下第一道家常菜'}}</text><text class="subtle">{{recipes.length ? '换个关键词，或把新的做法记下来。' : '把家里的拿手菜，收进全家的菜谱簿。'}}</text><button class="secondary-button" bindtap="addRecipe">记一道新菜</button></view>
</view>
