.edit-page {
  padding-top: 24rpx;
}

.edit-header {
  margin-bottom: 24rpx;
}

.edit-intro {
  display: block;
  margin-top: 10rpx;
  color: var(--muted);
  font-size: 24rpx;
  line-height: 1.5;
}

/* 主卡片容器 */
.edit-card {
  padding: 32rpx 28rpx 36rpx;
  border-radius: 32rpx;
}

.image-field {
  margin-top: 28rpx;
}

.image-field-heading {
  align-items: center;
  margin-bottom: 16rpx;
}

.image-remove-action {
  flex: none;
  min-height: 50rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: rgba(217, 79, 61, 0.08);
  color: var(--chili);
  font-size: 21rpx;
  font-weight: 650;
}

.recipe-image-picker {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 208rpx;
  overflow: hidden;
  border: 2rpx dashed rgba(79, 122, 96, 0.3);
  border-radius: 24rpx;
  background: linear-gradient(135deg, #f8fbf6, #eef4ed);
}

.recipe-image-picker.has-image {
  height: 300rpx;
  min-height: 0;
  border-style: solid;
  border-color: rgba(24, 51, 47, 0.1);
  background: #e3ebe2;
}

.recipe-image-preview {
  width: 100%;
  height: 100%;
}

.image-placeholder {
  display: flex;
  align-items: center;
  width: 100%;
  box-sizing: border-box;
  padding: 30rpx 28rpx;
}

.image-placeholder-mark {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  margin-right: 20rpx;
  border-radius: 22rpx;
  background: var(--leaf);
  color: #ffffff;
  font-size: 42rpx;
  font-weight: 300;
}

.image-placeholder-title,
.image-placeholder-note {
  display: block;
}

.image-placeholder-title {
  color: var(--ink);
  font-size: 26rpx;
  font-weight: 700;
}

.image-placeholder-note {
  margin-top: 7rpx;
  color: var(--muted);
  font-size: 21rpx;
}

.image-change-tip {
  position: absolute;
  right: 18rpx;
  bottom: 18rpx;
  padding: 9rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(24, 51, 47, 0.72);
  color: #ffffff;
  font-size: 20rpx;
}

/* 区块与表单项 */
.form-field {
  margin-top: 32rpx;
}

.form-field:first-child {
  margin-top: 0;
}

.field-label {
  display: block;
  margin-bottom: 12rpx;
  color: var(--ink);
  font-size: 26rpx;
  font-weight: 700;
  letter-spacing: 0.5rpx;
}

.field-label .required-mark {
  color: var(--chili);
  margin-left: 4rpx;
}

/* 输入框通用质感 */
.input-shell {
  width: 100%;
  height: 92rpx;
  box-sizing: border-box;
  padding: 0 28rpx;
  border: 2rpx solid var(--line);
  border-radius: 20rpx;
  background: #ffffff;
  color: var(--ink);
  font-size: 28rpx;
  transition: all 0.2s ease;
}

.input-shell:focus {
  border-color: var(--leaf);
  box-shadow: 0 0 0 4rpx rgba(79, 122, 96, 0.12);
}

/* 并排表单项 */
.form-pair {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.pair-item {
  flex: 1;
  min-width: 0;
}

/* 下拉选择框 (分类) */
.picker-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 92rpx;
  box-sizing: border-box;
  padding: 0 24rpx;
  border: 2rpx solid var(--line);
  border-radius: 20rpx;
  background: #ffffff;
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 600;
  transition: all 0.2s ease;
}

.picker-arrow-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(79, 122, 96, 0.08);
  color: var(--leaf);
  font-size: 20rpx;
  font-weight: bold;
}

/* 难度分段选择器 Segmented Control */
.difficulty-options {
  display: flex;
  padding: 6rpx;
  border-radius: 20rpx;
  background: rgba(24, 51, 47, 0.05);
  gap: 8rpx;
}

.difficulty-option {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  border-radius: 16rpx;
  color: var(--muted);
  font-size: 26rpx;
  font-weight: 600;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

.difficulty-option.active {
  background: #ffffff;
  color: var(--ink);
  font-weight: 700;
  box-shadow: 0 4rpx 14rpx rgba(24, 51, 47, 0.08);
}

/* 区域标题栏 */
.field-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.field-label-inline {
  display: inline-block;
  margin-bottom: 0;
  margin-right: 12rpx;
}

.field-caption {
  display: inline-block;
  color: #98a59e;
  font-size: 22rpx;
}

.add-row-action {
  flex: none;
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  height: 56rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: rgba(79, 122, 96, 0.1);
  color: var(--leaf);
  font-size: 24rpx;
  font-weight: 700;
  transition: all 0.2s ease;
}

.add-row-action:active {
  background: rgba(79, 122, 96, 0.2);
  transform: scale(0.97);
}

/* 食材与步骤列表 */
.ingredient-list,
.step-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.step-number {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  font-size: 22rpx;
  font-weight: 800;
}

.ingredient-tally {
  flex: none;
  color: var(--chili);
  font-size: 22rpx;
  font-weight: 700;
}

/* 已选食材：整行点按切换“用完 / 有剩” */
.ingredient-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 86rpx;
  box-sizing: border-box;
  padding: 0 16rpx 0 20rpx;
  border: 2rpx solid var(--line);
  border-radius: 18rpx;
  background: #ffffff;
  transition: all 0.2s ease;
}

.ingredient-row.used-up {
  border-color: rgba(217, 79, 61, 0.28);
  background: rgba(217, 79, 61, 0.04);
}

.used-up-check {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  box-sizing: border-box;
  border: 3rpx solid #95a59b;
  border-radius: 12rpx;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 800;
}

.ingredient-row.used-up .used-up-check {
  border-color: var(--chili);
  background: var(--chili);
}

.ingredient-name {
  flex: 1;
  min-width: 0;
  color: var(--ink);
  font-size: 27rpx;
  font-weight: 650;
}

.used-up-label {
  flex: none;
  color: var(--muted);
  font-size: 21rpx;
}

.ingredient-row.used-up .used-up-label {
  color: var(--chili);
  font-weight: 600;
}

.ingredient-empty {
  padding: 28rpx 0;
  border: 2rpx dashed rgba(79, 122, 96, 0.24);
  border-radius: 18rpx;
  color: #98a59e;
  font-size: 23rpx;
  text-align: center;
}

/* 添加食材：搜索框 + 候选标签 */
.ingredient-picker {
  margin-top: 18rpx;
}

.ingredient-search-input {
  height: 80rpx;
  font-size: 26rpx;
}

.suggestion-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}

.suggestion-chip {
  display: inline-flex;
  align-items: center;
  height: 56rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: rgba(79, 122, 96, 0.1);
  color: var(--leaf);
  font-size: 23rpx;
  font-weight: 600;
}

.suggestion-chip:active {
  background: rgba(79, 122, 96, 0.2);
}

.create-chip {
  background: var(--leaf);
  color: #ffffff;
}

.suggestion-empty {
  display: block;
  margin-top: 12rpx;
  color: #98a59e;
  font-size: 22rpx;
}

/* 删除按钮 */
.row-remove {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: rgba(217, 79, 61, 0.08);
  color: var(--chili);
  font-size: 32rpx;
  line-height: 1;
  transition: all 0.2s ease;
}

.row-remove:active {
  background: rgba(217, 79, 61, 0.18);
  transform: scale(0.92);
}

/* 步骤编辑 */
.step-field {
  padding-top: 36rpx;
  border-top: 2rpx dashed rgba(79, 122, 96, 0.16);
}

.step-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}

.step-number {
  margin-top: 14rpx;
  background: var(--ink);
  color: #ffffff;
}

.step-input {
  flex: 1;
  min-width: 0;
  min-height: 120rpx;
  box-sizing: border-box;
  padding: 18rpx 22rpx;
  border: 2rpx solid var(--line);
  border-radius: 18rpx;
  background: #ffffff;
  color: var(--ink);
  font-size: 27rpx;
  line-height: 1.55;
  transition: all 0.2s ease;
}

.step-input:focus {
  border-color: var(--leaf);
  box-shadow: 0 0 0 4rpx rgba(79, 122, 96, 0.12);
}

.step-remove {
  margin-top: 14rpx;
}

/* 提示小诀窍多行输入 */
.text-area {
  width: 100%;
  height: 160rpx;
  box-sizing: border-box;
  padding: 22rpx 24rpx;
  border: 2rpx solid var(--line);
  border-radius: 20rpx;
  background: #ffffff;
  color: var(--ink);
  font-size: 27rpx;
  line-height: 1.55;
  transition: all 0.2s ease;
}

.text-area:focus {
  border-color: var(--leaf);
  box-shadow: 0 0 0 4rpx rgba(79, 122, 96, 0.12);
}

.note-area {
  height: 140rpx;
}

/* 底部提交按钮 */
.save-button {
  margin-top: 36rpx;
  height: 96rpx;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 24rpx rgba(24, 51, 47, 0.18);
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  transition: all 0.2s ease;
}

.save-button:active {
  transform: scale(0.98);
  opacity: 0.95;
}

.ai-action {
  background: rgba(244, 201, 93, 0.2);
  color: var(--ink);
}

.ai-action.is-loading {
  opacity: 0.6;
}

.ai-review-message {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(244, 201, 93, 0.16);
  color: #806b2e;
  font-size: 23rpx;
  line-height: 1.45;
}

.ai-review-panel {
  margin-top: 20rpx;
  padding: 24rpx;
  border: 2rpx solid rgba(79, 122, 96, 0.18);
  border-radius: 24rpx;
  background: #fbfcf7;
}

.ai-review-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.ai-review-title,
.ai-review-caption {
  display: block;
}

.ai-review-title {
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 800;
}

.ai-review-caption {
  margin-top: 5rpx;
  color: var(--muted);
  font-size: 21rpx;
}

.ai-review-close {
  flex: none;
  padding: 8rpx 12rpx;
  color: var(--muted);
  font-size: 22rpx;
}

.ai-review-group + .ai-review-group {
  margin-top: 18rpx;
}

.ai-review-group-title {
  display: block;
  margin-bottom: 8rpx;
  color: var(--leaf);
  font-size: 22rpx;
  font-weight: 800;
}

.remove-title {
  color: var(--chili);
}

.ai-suggestion-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 16rpx 0;
  border-top: 1rpx solid rgba(79, 122, 96, 0.12);
}

.ai-suggestion-row.selected {
  background: rgba(79, 122, 96, 0.04);
}

.ai-check {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  border: 2rpx solid var(--line);
  border-radius: 50%;
  color: var(--muted);
  font-size: 24rpx;
  font-weight: 800;
}

.ai-check.checked {
  border-color: var(--leaf);
  background: var(--leaf);
  color: #ffffff;
}

.ai-check.remove-check {
  border-color: rgba(217, 79, 61, 0.35);
  color: var(--chili);
}

.ai-check.remove-check.checked {
  border-color: var(--chili);
  background: var(--chili);
  color: #ffffff;
}

.ai-suggestion-main {
  flex: 1;
  min-width: 0;
}

.ai-suggestion-title-row,
.ai-suggestion-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
}

.ai-suggestion-name {
  color: var(--ink);
  font-size: 26rpx;
  font-weight: 700;
}

.ai-suggestion-meta {
  justify-content: flex-start;
  flex-wrap: wrap;
  margin-top: 6rpx;
  color: var(--muted);
  font-size: 20rpx;
  line-height: 1.35;
}

.ai-confidence {
  padding: 3rpx 10rpx;
  border-radius: 999rpx;
  background: rgba(79, 122, 96, 0.1);
  color: var(--leaf);
  font-size: 19rpx;
}

.ai-confidence.medium {
  background: rgba(244, 201, 93, 0.2);
  color: #806b2e;
}

.ai-confidence.low {
  background: rgba(217, 79, 61, 0.1);
  color: var(--chili);
}

.ai-review-warning {
  margin-top: 12rpx;
  color: #806b2e;
  font-size: 21rpx;
  line-height: 1.4;
}

.ai-review-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 22rpx;
}

.ai-dismiss-button,
.ai-apply-button {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  box-sizing: border-box;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 700;
}

.ai-dismiss-button {
  border: 2rpx solid var(--line);
  color: var(--muted);
}

.ai-apply-button {
  background: var(--leaf);
  color: #ffffff;
}
