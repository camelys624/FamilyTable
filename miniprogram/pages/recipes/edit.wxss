.edit-page .design-copy { padding-right: 140rpx; }
.edit-page .page-title { font-size: 52rpx; }
.edit-intro { display: block; margin-top: 14rpx; font-size: 23rpx; line-height: 1.6; }
.edit-card { padding: 24rpx; margin-bottom: 20rpx; }
.form-field { margin-top: 24rpx; }
.form-field:first-child { margin-top: 0; }
.field-label { display: block; margin-bottom: 12rpx; font-size: 25rpx; font-weight: 700; }
.required-mark { color: var(--chili); margin-left: 4rpx; }
.edit-page .input-shell { width: 100%; background: #fff; font-size: 26rpx; }
.field-heading { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12rpx; margin-bottom: 16rpx; }
.field-label-inline { display: inline-block; margin-bottom: 0; }
.field-caption { display: block; margin-top: 6rpx; font-size: 21rpx; color: var(--muted); }
.image-remove-action, .ai-review-close { display: flex; align-items: center; min-height: 64rpx; padding: 0 12rpx; color: var(--muted); font-size: 23rpx; }
.recipe-image-picker { position: relative; border: 2rpx dashed #d1ddd0; border-radius: 20rpx; overflow: hidden; background: #fafbf6; }
.recipe-image-picker.has-image { height: 280rpx; border-style: solid; }
.recipe-image-preview { width: 100%; height: 100%; }
.image-placeholder { display: flex; align-items: center; gap: 20rpx; padding: 28rpx 24rpx; }
.image-placeholder-mark { display: flex; align-items: center; justify-content: center; width: 66rpx; height: 66rpx; border-radius: 18rpx; background: #e8f0e2; color: var(--leaf); font-size: 38rpx; flex: none; }
.image-placeholder-title { display: block; font-size: 25rpx; font-weight: 650; }
.image-placeholder-note { display: block; margin-top: 6rpx; font-size: 21rpx; color: var(--muted); }
.image-change-tip { position: absolute; right: 14rpx; bottom: 14rpx; color: #fff; background: rgba(24,51,47,0.75); padding: 8rpx 16rpx; border-radius: 999rpx; font-size: 21rpx; }
.form-pair { display: flex; gap: 18rpx; margin-top: 24rpx; }
.pair-item { flex: 1; min-width: 0; }
.picker-field { display: flex; justify-content: space-between; align-items: center; height: 82rpx; padding: 0 20rpx; background: #fff; border: 1rpx solid var(--line); border-radius: 18rpx; font-size: 26rpx; }
.picker-arrow-icon { color: var(--muted); }
.difficulty-options { display: flex; gap: 12rpx; }
.difficulty-option { flex: 1; min-width: 0; height: 70rpx; display: flex; justify-content: center; align-items: center; color: var(--ink); background: #eaf1e5; border-radius: 999rpx; font-size: 24rpx; }
.difficulty-option.active { color: #fff; background: var(--ink); }
.add-row-action { display: flex; align-items: center; justify-content: center; gap: 8rpx; min-height: 66rpx; padding: 0 18rpx; border-radius: 999rpx; color: var(--leaf); background: #eaf1e5; font-size: 23rpx; font-weight: 650; }
.ai-action { background: #fff0c9; color: #986d24; }
.ai-action.is-loading { opacity: 0.6; }
.ingredient-tally { color: #a87524; font-size: 22rpx; }
.ingredient-row { display: flex; align-items: center; gap: 12rpx; min-height: 96rpx; border-top: 1rpx solid #e5ece0; }
.used-up-check { display: flex; align-items: center; justify-content: center; width: 34rpx; height: 34rpx; border: 2rpx solid #98a69b; border-radius: 8rpx; color: #fff; flex: none; font-size: 23rpx; }
.used-up .used-up-check { background: var(--ink); border-color: var(--ink); }
.ingredient-name { flex: 1; min-width: 0; font-size: 26rpx; font-weight: 650; overflow-wrap: anywhere; }
.used-up-label { padding: 8rpx 14rpx; border-radius: 999rpx; color: #347a5d; background: #eaf3e7; font-size: 21rpx; flex: none; }
.used-up .used-up-label { color: #a47323; background: #fff0c9; }
.row-remove { display: flex; align-items: center; justify-content: center; width: 60rpx; height: 72rpx; color: #8b978d; font-size: 33rpx; flex: none; }
.ingredient-empty { color: var(--muted); border: 2rpx dashed #d9e3d4; border-radius: 18rpx; padding: 24rpx 20rpx; font-size: 23rpx; line-height: 1.6; }
.ingredient-picker { margin-top: 18rpx; }
.suggestion-list { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 14rpx; }
.suggestion-chip { display: flex; align-items: center; min-height: 60rpx; padding: 0 20rpx; border-radius: 999rpx; color: var(--leaf); background: #eaf2e5; font-size: 23rpx; }
.create-chip { background: var(--ink); color: #fff; }
.suggestion-empty { display: block; margin-top: 14rpx; font-size: 22rpx; color: var(--muted); }
.step-row { display: flex; gap: 12rpx; align-items: flex-start; margin-top: 16rpx; }
.step-number { display: flex; align-items: center; justify-content: center; width: 44rpx; height: 44rpx; flex: none; border-radius: 50%; background: #eaf2e5; color: var(--leaf); font-size: 24rpx; font-weight: 650; margin-top: 12rpx; }
.step-input { flex: 1; min-width: 0; min-height: 100rpx; box-sizing: border-box; padding: 16rpx 18rpx; border: 1rpx solid var(--line); border-radius: 18rpx; background: #fff; font-size: 25rpx; line-height: 1.6; }
.text-area { width: 100%; box-sizing: border-box; min-height: 140rpx; padding: 20rpx; border: 1rpx solid var(--line); border-radius: 18rpx; font-size: 25rpx; line-height: 1.6; background: #fff; }
.save-button { height: 84rpx; }
.ai-review-message { margin-top: 18rpx; padding: 18rpx 20rpx; border-radius: 18rpx; background: #fff1d1; color: #987538; font-size: 23rpx; line-height: 1.6; }
.ai-review-panel { padding: 22rpx; margin: 22rpx -4rpx 0; border-radius: 24rpx; border: 1rpx solid #d3e0cf; background: #f8fbf2; }
.ai-review-heading { display: flex; gap: 14rpx; align-items: flex-start; justify-content: space-between; margin-bottom: 20rpx; }
.ai-review-title { display: block; font-size: 30rpx; font-weight: 750; }
.ai-review-caption { display: block; font-size: 21rpx; color: var(--muted); margin-top: 8rpx; line-height: 1.6; }
.ai-review-group + .ai-review-group { margin-top: 20rpx; }
.ai-review-group-title { display: block; color: #a77a28; font-size: 24rpx; font-weight: 700; margin-bottom: 12rpx; }
.ai-suggestion-row { display: flex; align-items: flex-start; gap: 14rpx; padding: 18rpx 0; border-top: 1rpx solid #e1e9da; }
.ai-check { display: flex; align-items: center; justify-content: center; width: 38rpx; height: 38rpx; border: 2rpx solid #a0b19f; border-radius: 9rpx; color: var(--muted); flex: none; font-size: 24rpx; }
.ai-check.checked { background: var(--ink); border-color: var(--ink); color: #fff; }
.ai-check.remove-check.checked { background: #b2725a; border-color: #b2725a; }
.ai-suggestion-main { flex: 1; min-width: 0; }
.ai-suggestion-name { font-size: 26rpx; font-weight: 650; }
.ai-suggestion-meta { display: flex; flex-wrap: wrap; gap: 8rpx; font-size: 20rpx; color: var(--muted); line-height: 1.6; margin-top: 8rpx; }
.ai-confidence { padding: 2rpx 12rpx; color: #347a5d; background: #e5f0df; border-radius: 999rpx; }
.ai-confidence.medium, .ai-confidence.low { background: #fff1cc; color: #a47931; }
.ai-review-warning { margin-top: 12rpx; font-size: 22rpx; color: #a47931; line-height: 1.6; }
.ai-review-actions { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 22rpx; }
.ai-dismiss-button, .ai-apply-button { flex: 1; min-width: 180rpx; min-height: 78rpx; height: auto; padding: 12rpx; box-sizing: border-box; font-size: 24rpx; text-align: center; }
