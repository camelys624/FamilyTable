.recipe-page .design-copy { padding-right: 140rpx; }
.recipe-page .page-title { font-size: 52rpx; }
.add-recipe-button { width: 100%; height: 82rpx; margin-bottom: 22rpx; }
.search-box { display: flex; align-items: center; gap: 20rpx; height: 82rpx; padding: 0 26rpx; background: #fffefb; border-radius: 24rpx; margin: 22rpx 0 18rpx; }
.search-box input { flex: 1; min-width: 0; height: 70rpx; font-size: 26rpx; }
.search-icon { position: relative; width: 25rpx; height: 25rpx; border: 3rpx solid #79837f; border-radius: 50%; flex: none; }
.search-icon::after { content: ''; position: absolute; width: 12rpx; height: 3rpx; background: #79837f; right: -8rpx; bottom: -4rpx; transform: rotate(45deg); }
.search-placeholder { color: #939c96; }
.category-scroll { margin-bottom: 20rpx; }
.category-list { display: flex; gap: 10rpx; white-space: nowrap; }
.category-pill { flex: none; display: flex; align-items: center; justify-content: center; min-width: 102rpx; height: 70rpx; box-sizing: border-box; padding: 0 24rpx; border-radius: 22rpx; background: #fffefb; font-size: 24rpx; }
.category-pill.active { background: var(--ink); color: #fff; }
.recipe-grid { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1fr); gap: 16rpx; }
.recipe-card { overflow: hidden; padding: 12rpx; }
.recipe-cover { display: flex; align-items: center; justify-content: center; height: 240rpx; border-radius: 22rpx; background: #faf5e8; overflow: hidden; }
.cover-illustration { width: 278rpx; height: 278rpx; }
.recipe-cover-image { width: 100%; height: 100%; }
.recipe-body { padding: 14rpx 6rpx 12rpx; }
.recipe-card-title { display: block; font-size: 29rpx; font-weight: 750; overflow-wrap: anywhere; }
.recipe-time { display: block; font-size: 22rpx; color: var(--muted); margin: 10rpx 0; }
.recipe-card-meta { display: inline-block; padding: 6rpx 12rpx; border-radius: 999rpx; background: #eaf3e8; color: var(--leaf); font-size: 20rpx; line-height: 1.5; }
.recipe-note { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; margin-top: 12rpx; color: var(--muted); font-size: 22rpx; line-height: 1.55; }
.recipe-page .add-recipe-button { width: 100%; min-width: 100%; max-width: 100%; box-sizing: border-box; }
