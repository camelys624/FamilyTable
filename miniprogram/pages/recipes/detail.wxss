.detail-page { padding: 0 28rpx 48rpx; }
.recipe-hero { display: flex; align-items: center; justify-content: center; margin: 0 -28rpx; height: 380rpx; overflow: hidden; background: #f6efdf; }
.hero-image { width: 100%; height: 100%; }
.detail-illustration { width: 510rpx; height: 510rpx; }
.detail-sheet { position: relative; padding-top: 24rpx; }
.detail-time { margin-top: 14rpx; }
.ingredient-list, .instruction-list { padding: 22rpx 24rpx; margin-top: 24rpx; }
.ingredient-list .design-heading, .instruction-list .design-heading { margin-bottom: 12rpx; }
.ingredient-row { display: flex; align-items: center; gap: 12rpx; min-height: 100rpx; border-top: 1rpx solid #e9eee5; }
.ingredient-name { flex: 1; min-width: 0; font-size: 27rpx; font-weight: 650; overflow-wrap: anywhere; }
.ingredient-row .design-badge { flex: none; font-size: 20rpx; padding: 8rpx 12rpx; }
.instruction-row { display: flex; align-items: flex-start; gap: 18rpx; padding: 16rpx 0; }
.instruction-index { flex: none; display: flex; align-items: center; justify-content: center; width: 46rpx; height: 46rpx; border-radius: 50%; background: var(--ink); color: #fff; font-size: 24rpx; }
.instruction-text { flex: 1; min-width: 0; font-size: 27rpx; line-height: 1.7; overflow-wrap: anywhere; }
.menu-note { margin-top: 24rpx; padding: 20rpx 24rpx; border-radius: 20rpx; background: #fff1cc; color: #8a7040; font-size: 23rpx; line-height: 1.6; }
.detail-actions { display: flex; gap: 14rpx; }
.detail-actions .delete-button { flex: 0 0 30%; color: var(--muted); border-color: #9ea9a1; }
.detail-actions .edit-button { flex: 1; height: 82rpx; }
