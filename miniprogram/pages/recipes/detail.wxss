.detail-page {
  min-height: 100vh;
  background: var(--jade);
}

.recipe-hero {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 430rpx;
  overflow: hidden;
  color: #ffffff;
}

.hero-image {
  position: absolute;
  width: 100%;
  height: 100%;
}

.recipe-hero.has-image::after {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(24, 51, 47, 0.04), rgba(24, 51, 47, 0.34));
  content: '';
}

.hero-rings,
.hero-rings::before,
.hero-rings::after {
  position: absolute;
  border: 3rpx solid rgba(255, 255, 255, 0.24);
  border-radius: 50%;
  content: '';
}

.hero-rings {
  width: 310rpx;
  height: 310rpx;
}

.hero-rings::before {
  inset: 42rpx;
}

.hero-rings::after {
  inset: 88rpx;
}

.hero-initial {
  position: relative;
  font-family: "STKaiti", "KaiTi", serif;
  font-size: 126rpx;
  font-weight: 900;
}

.hero-stamp {
  position: absolute;
  right: 34rpx;
  bottom: 34rpx;
  padding: 13rpx 18rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.82);
  border-radius: 8rpx;
  font-family: monospace;
  font-size: 21rpx;
  font-weight: 700;
  z-index: 2;
  transform: rotate(3deg);
}

.detail-sheet {
  position: relative;
  margin-top: -34rpx;
  padding: 46rpx 28rpx 40rpx;
  border-radius: 38rpx 38rpx 0 0;
  background: var(--jade);
}

.detail-title {
  margin-top: 8rpx;
  font-family: "STKaiti", "KaiTi", serif;
  font-size: 62rpx;
  font-weight: 900;
}

.recipe-note {
  display: block;
  margin-top: 18rpx;
  color: var(--muted);
  font-size: 25rpx;
  line-height: 1.7;
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 42rpx;
}

.ingredient-count {
  color: var(--leaf);
  font-family: monospace;
  font-size: 22rpx;
}

.ingredient-list {
  margin-top: 18rpx;
  padding: 0 25rpx;
}

.ingredient-row {
  display: flex;
  align-items: center;
  min-height: 92rpx;
  border-bottom: 2rpx solid #edf0ed;
}

.ingredient-row:last-child {
  border-bottom: 0;
}

.ingredient-index {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: var(--ink);
  color: #ffffff;
  font-family: monospace;
  font-size: 18rpx;
}

.ingredient-name {
  flex: 1;
  margin-left: 20rpx;
  font-weight: 700;
}

.ingredient-amount {
  color: var(--muted);
  font-family: monospace;
  font-size: 23rpx;
}

.step-heading {
  margin-top: 36rpx;
}

.instruction-list {
  margin-top: 18rpx;
  padding: 12rpx 25rpx;
}

.instruction-row {
  display: flex;
  align-items: flex-start;
  padding: 22rpx 0;
  border-bottom: 2rpx solid #edf0ed;
}

.instruction-row:last-child {
  border-bottom: 0;
}

.instruction-index {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: var(--leaf);
  color: #ffffff;
  font-family: monospace;
  font-size: 18rpx;
  font-weight: 800;
}

.instruction-text {
  flex: 1;
  margin-left: 20rpx;
  color: var(--ink);
  font-size: 25rpx;
  line-height: 1.65;
}

.menu-note {
  position: relative;
  margin-top: 24rpx;
  padding: 24rpx 26rpx 24rpx 42rpx;
  border-radius: 8rpx 24rpx 24rpx 24rpx;
  background: var(--yolk);
  color: rgba(24, 51, 47, 0.78);
  font-size: 22rpx;
  line-height: 1.55;
  transform: rotate(-0.5deg);
}

.note-pin {
  position: absolute;
  left: 15rpx;
  top: 15rpx;
  width: 9rpx;
  height: 9rpx;
  border-radius: 50%;
  background: var(--ink);
}

.detail-actions {
  display: grid;
  grid-template-columns: 180rpx 1fr;
  gap: 18rpx;
  margin-top: 34rpx;
}

.delete-button {
  border-color: var(--chili);
  color: var(--chili);
}

.edit-button,
.delete-button {
  width: 100%;
}

.tomato { background: #d94f3d; }
.berry { background: #8f4a56; }
.green { background: #4f7a60; }
.grain { background: #c39243; }
.ocean { background: #477a83; }
