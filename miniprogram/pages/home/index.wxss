.home-navigation { position: fixed; top: 0; left: 0; right: 0; z-index: 10; background: #eaf2ea; color: #18332f; }
.home-navigation-title { display: flex; align-items: center; justify-content: center; box-sizing: border-box; font-size: 32rpx; font-weight: 700; white-space: nowrap; }
.home-page { --muted: #56675f; min-height: 0; padding-bottom: calc(32rpx + env(safe-area-inset-bottom)); }
.home-page .design-copy { padding-right: 160rpx; }
.home-page .page-title { font-size: 52rpx; overflow-wrap: anywhere; word-break: break-all; }
.home-page .eyebrow, .home-page .design-note, .home-page .subtle { font-size: 24rpx; }
.home-page .eyebrow { color: #315b42; }
.home-page .paper-card { padding: 24rpx; }
.home-page .paper-card + .paper-card { margin-top: 24rpx; }
.home-page .design-heading { min-height: 88rpx; margin: 0 0 12rpx; }
.home-page .section-title { font-size: 32rpx; line-height: 1.4; }
.home-page .design-link { width: auto; min-height: 88rpx; min-width: 88rpx; margin: 0; padding: 0 8rpx; background: transparent; color: #2d684f; font-size: 24rpx; line-height: 1.5; }
.home-page .design-chevron { color: #56675f; }
.meal-row { display: flex; align-items: center; gap: 12rpx; min-height: 152rpx; padding: 12rpx 0; }
.meal-row + .meal-row { border-top: 1rpx solid #d7e1d8; }
.meal-label { flex: none; padding: 10rpx 8rpx; border-radius: 12rpx; text-align: center; background: #eaf2e8; color: #315b42; font-size: 24rpx; font-weight: 700; }
.dish-preview { flex: none; width: 132rpx; height: 132rpx; }
.dish-photo { width: 100%; height: 100%; border-radius: 20rpx; }
.food-art { position: relative; width: 100%; height: 100%; overflow: hidden; }
.food-sheet { position: absolute; top: 0; width: 200%; height: 100%; max-width: none; }
.dish-art { width: 132rpx; height: 132rpx; }
.dish-plate { display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; border-radius: 22rpx; background: #f5efdf; }
.plate-rim { position: relative; display: flex; align-items: center; justify-content: center; width: 84%; height: 76%; border-radius: 50%; border: 3rpx solid #d8e1cf; background: #fffefb; box-shadow: inset 0 0 0 7rpx #f0f3e8, 0 5rpx 0 #e3dbc7; }
.food-symbol { font-size: 66rpx; line-height: 1; }
.plate-leaf { position: absolute; width: 18rpx; height: 10rpx; right: 15%; bottom: 17%; border-radius: 0 80%; background: #6d8c4f; transform: rotate(-25deg); }
.meal-copy { min-width: 0; flex: 1; }
.dish-name { display: block; font-size: 28rpx; font-weight: 750; overflow-wrap: anywhere; }
.dish-meta { display: block; margin-top: 10rpx; color: var(--muted); font-size: 24rpx; line-height: 1.6; overflow-wrap: anywhere; }
.vote-card .design-note { margin-top: 6rpx; }
.candidate-row { display: flex; flex-wrap: wrap; gap: 12rpx; }
.candidate-chip { display: flex; flex: 1 1 42%; align-items: center; min-width: 0; gap: 8rpx; min-height: 100rpx; padding: 10rpx; box-sizing: border-box; border: 2rpx solid #d7e1d8; border-radius: 20rpx; background: #fffdf7; }
.candidate-chip.picked { border-color: #739b7e; background: #e9f4ea; }
.candidate-thumb { width: 88rpx; height: 88rpx; flex: none; }
.candidate-thumb .dish-art { width: 88rpx !important; height: 88rpx !important; }
.candidate-thumb .food-symbol { font-size: 46rpx; }
.candidate-name { font-weight: 650; font-size: 24rpx; flex: 1; overflow-wrap: anywhere; }
.candidate-vote { font-size: 24rpx; color: #2d684f; flex: none; }
.vote-actions { display: flex; justify-content: flex-end; }
.vote-empty-state { padding: 8rpx 0 0; }
.empty-vote { display: block; color: var(--muted); padding: 8rpx 0 16rpx; font-size: 24rpx; line-height: 1.6; }
.home-page .vote-create, .home-page .vote-retry { min-height: 88rpx; margin-top: 8rpx; width: 100%; font-size: 26rpx; }
.shopping-card { display: flex; align-items: center; gap: 12rpx; }
.shopping-copy { flex: 1; min-width: 0; }
.shopping-copy .section-title { display: block; }
.shopping-note { display: block; margin-top: 8rpx; font-size: 24rpx; color: #78521b; line-height: 1.6; overflow-wrap: anywhere; }
.shopping-action { display: inline-flex; align-items: center; justify-content: center; flex: none; min-height: 88rpx; min-width: 88rpx; padding: 0 8rpx; color: #2d684f; font-size: 24rpx; font-weight: 650; }
.kitchen-tip { margin-top: 28rpx; padding: 8rpx 16rpx 0; }
.tip-label { display: block; color: #315b42; font-size: 24rpx; font-weight: 700; }
.tip-copy { display: block; margin-top: 10rpx; color: var(--muted); font-size: 24rpx; line-height: 1.7; }
