.home-page .design-copy { padding-right: 160rpx; }
.home-page .page-title { font-size: 52rpx; }
.today-card { padding: 12rpx 20rpx 20rpx; }
.today-card .design-heading { margin: 0 4rpx 6rpx; }
.meal-row { display: flex; align-items: center; gap: 12rpx; min-height: 136rpx; padding: 0 12rpx; border: 1rpx solid rgba(24,51,47,0.08); border-radius: 22rpx; background: #fffdf7; }
.meal-row + .meal-row { margin-top: 12rpx; }
.meal-label { flex: none; width: 70rpx; height: 70rpx; line-height: 70rpx; border-radius: 50%; text-align: center; background: #fff0c9; font-size: 24rpx; font-weight: 700; }
.meal-row:nth-child(3) .meal-label { background: #e8f1e5; }
.meal-row:nth-child(4) .meal-label { background: #e6f0f2; }
.recommend-label { background: #eee9dc; color: var(--muted); }
.dish-preview { flex: none; width: 132rpx; height: 132rpx; }
.dish-photo { width: 100%; height: 100%; border-radius: 20rpx; }
.meal-copy { min-width: 0; flex: 1; }
.dish-name { display: block; font-size: 28rpx; font-weight: 750; overflow-wrap: anywhere; }
.dish-meta { display: block; margin-top: 10rpx; color: var(--muted); font-size: 23rpx; }
.vote-card { margin-top: 20rpx; padding: 18rpx 24rpx 10rpx; }
.vote-card .design-heading { margin-bottom: 12rpx; }
.vote-card .design-note { margin-top: 6rpx; }
.candidate-row { display: flex; flex-wrap: wrap; gap: 12rpx; }
.candidate-chip { display: flex; flex: 1 1 42%; align-items: center; min-width: 0; gap: 8rpx; min-height: 100rpx; padding: 0 12rpx; box-sizing: border-box; border: 2rpx solid #e2e9dd; border-radius: 20rpx; background: #fffdf7; }
.candidate-chip.picked { border-color: #8db29a; background: #e9f4ea; }
.candidate-thumb { width: 100rpx; height: 100rpx; flex: none; }
.candidate-name { font-weight: 650; font-size: 23rpx; flex: 1; overflow-wrap: anywhere; }
.candidate-vote { font-size: 20rpx; color: #347a5d; flex: none; }
.empty-vote { color: var(--muted); padding: 18rpx 0; }
.shopping-card { display: flex; align-items: center; gap: 12rpx; margin-top: 20rpx; padding: 18rpx 20rpx; }
.shopping-copy { flex: 1; min-width: 0; }
.shopping-title { display: block; font-size: 29rpx; font-weight: 750; }
.shopping-note { display: block; font-size: 22rpx; color: #a56f20; margin-top: 8rpx; line-height: 1.5; }
.shopping-action { flex: none; padding: 18rpx 16rpx; color: #fff; background: var(--ink); border-radius: 18rpx; font-size: 22rpx; }
