.menu-page .design-copy { padding-right: 190rpx; }
.week-stamp { position: absolute; right: 4rpx; top: 0; padding: 8rpx 16rpx; background: #fff0c9; color: #946e27; border-radius: 16rpx; font-size: 22rpx; }
.menu-page .hero-picture { top: 14rpx; }
.day-scroll { width: 100%; margin-bottom: 24rpx; }
.day-list { display: flex; gap: 8rpx; min-width: 100%; }
.day-tab { flex: 1; min-width: 82rpx; height: 124rpx; display: flex; align-items: center; justify-content: center; flex-direction: column; border-radius: 24rpx; background: #fffefb; color: var(--ink); box-sizing: border-box; }
.day-tab.active { background: var(--ink); color: #fff; }
.day-week { font-size: 22rpx; }
.day-date { margin-top: 6rpx; font-size: 23rpx; }
.day-dot { width: 9rpx; height: 9rpx; margin-top: 8rpx; border-radius: 50%; }
.day-dot.has-menu { background: #e6a932; }
.selected-line { margin: 12rpx 8rpx 16rpx; font-size: 28rpx; font-weight: 750; }
.meal-card { padding: 16rpx 18rpx 20rpx; margin-bottom: 16rpx; }
.meal-heading { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12rpx; }
.meal-heading-copy { display: flex; align-items: center; gap: 14rpx; }
.meal-symbol { color: #d9a233; font-size: 40rpx; }
.add-dish { display: flex; align-items: center; min-height: 66rpx; padding: 0 20rpx; background: #eaf3e9; color: #347a5d; font-size: 24rpx; border-radius: 999rpx; }
.dish-ticket { position: relative; display: flex; flex-wrap: wrap; align-items: center; gap: 8rpx; min-height: 110rpx; padding: 0 4rpx; border: 1rpx solid var(--line); border-radius: 20rpx; }
.dish-ticket + .dish-ticket { margin-top: 12rpx; }
.ticket-art { flex: none; width: 100rpx; height: 100rpx; }
.ticket-photo { width: 100%; height: 100%; border-radius: 18rpx; }
.ticket-copy { flex: 1; min-width: 100rpx; }
.ticket-name { display: block; font-size: 26rpx; font-weight: 750; overflow-wrap: anywhere; }
.ticket-meta { display: block; margin-top: 8rpx; font-size: 22rpx; color: var(--muted); }
.cook-action { flex: none; min-height: 70rpx; padding: 0 12rpx; display: flex; align-items: center; justify-content: center; border: 1rpx solid #97b6a2; background: transparent; color: #347a5d; font-size: 20rpx; border-radius: 16rpx; line-height: 1.3; }
.ticket-remove { flex: none; width: 60rpx; height: 76rpx; display: flex; align-items: center; justify-content: center; color: #839188; font-size: 34rpx; }
.empty-meal { display: flex; align-items: center; justify-content: center; gap: 20rpx; min-height: 124rpx; border: 2rpx dashed #d4dfd5; border-radius: 20rpx; color: var(--muted); }
.empty-meal text { display: block; }
.empty-meal-symbol { font-size: 42rpx; color: #a9b4ac; }
.repeat-note { display: flex; gap: 16rpx; padding: 20rpx 24rpx; background: #fff5db; border-radius: 24rpx; color: #8b753f; font-size: 23rpx; line-height: 1.5; }
.picker-mask { position: fixed; inset: 0; z-index: 20; background: rgba(24,33,28,0.4); }
.recipe-picker { position: fixed; left: 0; right: 0; bottom: 0; z-index: 21; box-sizing: border-box; max-height: 78vh; padding: 14rpx 28rpx calc(24rpx + env(safe-area-inset-bottom)); border-radius: 36rpx 36rpx 0 0; background: #fffefb; }
.picker-handle { width: 76rpx; height: 8rpx; border-radius: 999rpx; background: #d9dfd9; margin: 0 auto 24rpx; }
.picker-header { display: flex; justify-content: space-between; align-items: flex-start; margin: 0 8rpx 22rpx; }
.picker-title { display: block; font-size: 42rpx; font-weight: 750; margin-bottom: 6rpx; }
.picker-close { display: flex; align-items: center; justify-content: center; width: 76rpx; height: 76rpx; border-radius: 50%; background: #f1f3ed; color: var(--muted); font-size: 42rpx; }
.picker-list { height: 50vh; }
.picker-recipe { display: flex; gap: 20rpx; align-items: center; min-height: 156rpx; border-bottom: 1rpx solid var(--line); }
.picker-art { width: 132rpx; height: 132rpx; flex: none; }
.picker-copy { flex: 1; min-width: 0; }
.picker-name { display: block; margin-bottom: 10rpx; font-size: 29rpx; font-weight: 700; }
.picker-add { display: flex; align-items: center; justify-content: center; width: 68rpx; height: 68rpx; color: #fff; border-radius: 50%; background: var(--ink); font-size: 36rpx; flex: none; }
.menu-page .cook-action { width: 220rpx; min-width: 0; max-width: 220rpx; flex: 0 0 220rpx; box-sizing: border-box; }
