<view class="page-shell fridge-page safe-bottom">
  <view class="fridge-hero">
    <view class="hero-copy"><text class="eyebrow">家的食材 · 好好珍惜</text><view class="page-title">打开冰箱</view><text class="subtle hero-note">看看家里还有什么，先吃临期的。</text></view>
    <view class="illustration hero-art {{batches.length ? 'art-fridge' : 'art-empty'}}" aria-hidden="true"><image class="sprite-sheet" src="/assets/fridge/illustrations-v1.webp" mode="scaleToFill" /></view>
  </view>
  <view class="hero-actions">
    <button class="primary-button add-button" bindtap="openAdd" disabled="{{saving}}"><text class="add-symbol">＋</text>记一份食材</button>
    <button class="secondary-button refresh-button" bindtap="refresh" loading="{{loading}}" disabled="{{loading || saving}}"><view class="refresh-icon" wx:if="{{!loading}}"></view>刷新</button>
  </view>
  <view class="paper-card inventory-card">
    <view class="section-heading inventory-heading"><text class="section-title">我的食材</text><view class="inventory-summary"><text>{{loading || loadError ? '—' : availableCount}} 批可用</text><text class="near-count" wx:if="{{!loading && !loadError && nearExpiryCount}}">{{nearExpiryCount}} 批临期</text></view></view>
    <view class="inventory-filters" wx:if="{{batches.length && !loadError}}">
      <button class="filter-chip {{inventoryFilter === 'all' ? 'selected' : ''}}" data-filter="all" bindtap="changeInventoryFilter">全部</button>
      <button class="filter-chip {{inventoryFilter === 'near' ? 'selected' : ''}}" data-filter="near" bindtap="changeInventoryFilter">临期</button>
      <button class="filter-chip {{inventoryFilter === 'available' ? 'selected' : ''}}" data-filter="available" bindtap="changeInventoryFilter">可用</button>
    </view>
    <view class="inventory-status" wx:if="{{loading}}">正在查看冰箱…</view>
    <view class="inventory-error" wx:elif="{{loadError}}"><text class="cloud-error-title">冰箱暂时打不开</text><text class="cloud-error-message">{{loadError}}</text><button class="secondary-button error-retry" bindtap="refresh">重新加载</button></view>
    <view class="inventory-empty" wx:elif="{{!batches.length}}">
      <view class="illustration empty-art art-empty" aria-hidden="true"><image class="sprite-sheet" src="/assets/fridge/illustrations-v1.webp" mode="scaleToFill" /></view>
      <text class="empty-title">冰箱还没记食材</text><text class="subtle">把家里剩下的放进来吧。</text>
      <button class="primary-button first-batch-button" bindtap="openAdd" disabled="{{saving}}">＋ 记第一份食材</button>
    </view>
    <block wx:else>
      <view class="filter-empty" wx:if="{{!filteredBatches.length}}">{{inventoryFilter === 'near' ? '暂无未来 3 天内到期的可用食材' : '暂无可用食材，请核对过期或变质的批次'}}</view>
      <view class="batch-row" wx:for="{{filteredBatches}}" wx:key="id">
        <view class="batch-main" data-id="{{item.id}}" bindtap="openEdit" role="button" aria-label="修改{{item.name}}">
          <view class="batch-art"><view class="illustration food-art art-{{item.art}}" wx:if="{{item.art}}" aria-hidden="true"><image class="sprite-sheet" src="/assets/fridge/illustrations-v1.webp" mode="scaleToFill" /></view><text class="food-emoji" wx:else aria-hidden="true">{{item.foodEmoji}}</text></view>
          <view class="batch-copy"><text class="batch-name">{{item.name}}</text><text class="subtle expiry-text">{{item.expiryText}}</text></view>
          <text class="batch-badge {{item.badgeTone}}">{{item.badgeLabel}}</text><text class="row-chevron">›</text>
        </view>
        <view class="batch-footer" wx:if="{{!item.usable}}"><text class="batch-warning">不参与做菜和建议</text><button class="batch-discard" data-id="{{item.id}}" bindtap="discardBatch" disabled="{{saving}}">{{item.expired ? '确认丢弃' : '记录报损'}}</button></view>
      </view>
      <text class="inventory-footnote">临期提醒为未来 3 天内到期；重新购入请记为新批次。</text>
    </block>
  </view>
  <view class="paper-card ai-card {{!availableCount || loadError ? 'ai-disabled' : ''}}">
    <view class="ai-copy"><text class="ai-label">AI 建议</text><text class="section-title ai-title">冰箱里能做什么</text><text class="subtle ai-description">{{loadError ? '先重新加载冰箱，再来想菜单。' : (!availableCount ? '记下可用食材后，再来想菜单。' : '用现有食材，想几道家常菜。')}}</text><button class="primary-button suggest-button" bindtap="suggest" loading="{{aiLoading}}" disabled="{{aiLoading || saving || loading || loadError || !availableCount}}">{{aiLoading ? '正在想菜单…' : '帮我想几道菜'}}</button></view>
    <view class="illustration pan-art art-pan" aria-hidden="true"><image class="sprite-sheet" src="/assets/fridge/illustrations-v1.webp" mode="scaleToFill" /></view><text class="ai-footnote">建议只供参考，做菜前再核对食材。</text>
  </view>
  <view class="suggestion-error" wx:if="{{aiError}}"><text>{{aiError}}</text><text class="subtle">食材录入和做菜记录仍可使用。</text></view>
  <view class="paper-card suggestion-empty" wx:if="{{aiLoaded && !suggestions.length && !aiError}}">这次没有合适的建议，补充食材后再试试。</view>
  <view class="paper-card suggestion-card" wx:for="{{suggestions}}" wx:key="name"><view class="section-heading"><text class="batch-name">{{item.name}}</text><text class="batch-badge {{item.canCook ? 'available' : 'near'}}">{{item.canCook ? '可以做' : '需补购'}}</text></view><text class="subtle">{{item.reason}}</text><text class="suggestion-line">已有：{{item.availableLabel}}</text><text class="missing-ingredients" wx:if="{{!item.canCook}}">需补购：{{item.missingLabel}}</text><text class="subtle suggestion-steps" wx:if="{{item.stepsLabel}}">{{item.stepsLabel}}</text></view>
  <view class="records-section">
    <view class="section-heading records-heading"><text class="section-title">食材变动记录</text><button class="records-refresh" bindtap="loadRecords" loading="{{recordsLoading}}" disabled="{{recordsLoading}}"><view class="refresh-icon" wx:if="{{!recordsLoading}}"></view>刷新记录</button></view>
    <view class="paper-card records-card">
      <text class="subtle records-status" wx:if="{{recordsLoading}}">正在读取记录…</text>
      <view class="records-error" wx:if="{{recordsError}}"><text>{{recordsError}}</text><button class="records-refresh" bindtap="loadRecords" disabled="{{recordsLoading}}">重新读取</button></view>
      <view class="record-empty" wx:if="{{recordsLoaded && !records.length && !recordsError && !recordsLoading}}"><view class="record-icon" aria-hidden="true">≡</view><text class="subtle">还没有食材变动。</text></view>
      <view class="record-row" wx:for="{{records}}" wx:key="id"><view class="record-icon" aria-hidden="true">≡</view><view class="record-copy"><view class="record-heading"><text class="record-name">{{item.name}}</text><text class="record-type">{{item.typeLabel}}</text></view><text class="subtle record-detail">{{item.detail}}</text><text class="record-time">{{item.timeLabel}}</text></view></view>
      <button class="more-records" wx:if="{{recordsHasMore}}" bindtap="moreRecords" loading="{{recordsLoading}}" disabled="{{recordsLoading}}">查看更多记录 ›</button>
    </view>
  </view>
  <view class="sheet-overlay" wx:if="{{editorVisible || discardId}}">
    <view class="sheet-backdrop" bindtap="closeSheet"></view>
    <view class="editor-sheet"><view class="sheet-handle"></view><scroll-view scroll-y class="sheet-body">
      <view wx:if="{{editorVisible}}">
        <view class="sheet-heading"><text class="section-title">{{editingId ? '修改这一批' : '放进冰箱'}}</text><button class="sheet-close" bindtap="closeEditor" disabled="{{saving}}">取消</button></view><text class="subtle">按购入批次记，有剩就留着，用完再补货。</text>
        <label class="field-label" for="ingredient-name">食材名称</label><input id="ingredient-name" class="input-shell" value="{{formName}}" maxlength="40" placeholder="例如：番茄" bindinput="inputName" disabled="{{saving}}" />
        <text class="field-label">保质期至（选填）</text><picker mode="date" value="{{formExpiry}}" bindchange="changeExpiry" disabled="{{saving}}"><view class="input-shell date-field">{{formExpiry || '选择日期'}}</view></picker>
        <view class="expiry-help"><text class="subtle">未填写日期，不代表一定安全。</text><button class="text-button" bindtap="clearExpiry" disabled="{{saving}}">清除日期</button></view><text class="error-text" wx:if="{{saveError}}">{{saveError}}</text>
        <button class="primary-button sheet-save" bindtap="saveBatch" loading="{{saving}}" disabled="{{saving}}">{{editingId ? '保存修改' : '记入冰箱'}}</button>
        <button class="edit-discard" wx:if="{{editingId}}" bindtap="discardEditingBatch" disabled="{{saving}}">记录报损 / 丢弃这一批</button>
      </view>
      <view wx:else>
        <view class="sheet-heading"><text class="section-title">记录报损</text><button class="sheet-close" bindtap="closeDiscard" disabled="{{saving}}">取消</button></view><text class="discard-name">{{discardName}}</text>
        <text class="field-label">报损原因</text><picker range="{{discardReasons}}" value="{{discardReasonIndex}}" bindchange="changeDiscardReason" disabled="{{saving}}"><view class="input-shell date-field">{{discardReasons[discardReasonIndex]}}</view></picker>
        <checkbox-group bindchange="changeDiscardUsedUp"><label class="discard-checkbox"><checkbox value="usedUp" checked="{{discardUsedUp}}" disabled="{{saving}}" color="#4f7a60" />这一批已全部丢弃</label></checkbox-group><text class="subtle">未全部丢弃会保留有剩；过期或变质批次仍不能用于做菜。</text><text class="error-text" wx:if="{{saveError}}">{{saveError}}</text>
        <button class="primary-button sheet-save" bindtap="confirmDiscard" loading="{{saving}}" disabled="{{saving}}">确认报损</button>
      </view>
    </scroll-view></view>
  </view>
</view>
