<view class="page-shell design-page onboarding">
  <view class="brand-row"><view class="brand-bowl"></view><text>家常</text></view>
  <view class="intro-copy"><text class="eyebrow">一家人 · 好好吃饭</text><view class="page-title"><view>把每天吃什么，</view><view>变成全家的小期待。</view></view><text class="design-note">排一周菜单、一起投票，缺什么列成采购单。</text></view>
  <view class="table-art"><kitchen-art kind="table" art-size="onboarding-illustration" size="480" /></view>
  <view class="join-card paper-card">
    <view class="mode-tabs"><view class="mode-tab {{mode === 'create' ? 'active' : ''}}" data-mode="create" bindtap="setMode">创建家庭</view><view class="mode-tab {{mode === 'join' ? 'active' : ''}}" data-mode="join" bindtap="setMode">加入家庭</view></view>
    <view class="avatar-field"><text class="field-label">头像 <text class="subtle">（可跳过）</text></text><button class="avatar-picker" disabled="{{submitting}}" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar"><image wx:if="{{avatarPath}}" class="avatar-preview" src="{{avatarPath}}" mode="aspectFill" /><text wx:else>＋</text></button></view>
    <view class="form-field"><text class="field-label">怎么称呼你</text><input class="input-shell" type="nickname" value="{{userName}}" maxlength="12" disabled="{{submitting}}" bindinput="onUserName" placeholder="例如：妈妈、小满" /></view>
    <view class="form-field" wx:if="{{mode === 'create'}}"><text class="field-label">给你们的家庭起个名字</text><input class="input-shell" value="{{familyName}}" maxlength="20" disabled="{{submitting}}" bindinput="onFamilyName" placeholder="给你们的饭桌取个名字" /></view>
    <view class="form-field" wx:else><text class="field-label">家庭邀请码</text><input class="input-shell code-input" value="{{inviteCode}}" maxlength="8" disabled="{{submitting}}" bindinput="onInviteCode" placeholder="输入家人发来的 8 位邀请码" /><text wx:if="{{isLocal}}" class="demo-code">本地体验码：JCFAN725</text><text wx:else class="demo-code">请管理员在「我的」页面生成邀请码。</text></view>
    <text wx:if="{{errorMessage}}" class="form-error">{{errorMessage}}</text>
    <button class="primary-button continue-button" bindtap="continue" loading="{{submitting}}" disabled="{{submitting}}">{{submitting ? '正在准备饭桌…' : (mode === 'create' ? '开张我的小饭桌' : '加入他们的饭桌')}}</button><text class="privacy-note">继续即表示同意用户协议与隐私政策</text>
  </view>
</view>
