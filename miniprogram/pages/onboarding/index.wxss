.onboarding { padding-top: 26rpx; padding-bottom: calc(32rpx + env(safe-area-inset-bottom)); }
.brand-row { display: flex; align-items: center; gap: 14rpx; margin-bottom: 30rpx; font-family: "STKaiti","KaiTi",serif; font-size: 38rpx; font-weight: 750; }
.brand-bowl { width: 48rpx; height: 25rpx; border: 3rpx solid var(--ink); border-radius: 8rpx 8rpx 28rpx 28rpx; position: relative; }
.brand-bowl::before { content: ''; position: absolute; left: 18rpx; top: -18rpx; width: 8rpx; height: 12rpx; border-left: 3rpx solid var(--ink); transform: rotate(20deg); }
.intro-copy .page-title { font-size: 53rpx; line-height: 1.3; }
.table-art { display: flex; justify-content: center; height: 308rpx; overflow: hidden; margin: 0 -28rpx -16rpx; }
.onboarding-illustration { width: 480rpx; height: 480rpx; margin-top: -60rpx; }
.join-card { position: relative; padding: 22rpx 24rpx 24rpx; }
.mode-tabs { display: flex; background: #eaf2e7; padding: 6rpx; border-radius: 22rpx; margin-bottom: 24rpx; }
.mode-tab { flex: 1; display: flex; align-items: center; justify-content: center; height: 70rpx; font-size: 27rpx; font-weight: 650; border-radius: 18rpx; }
.mode-tab.active { color: #fff; background: var(--ink); }
.avatar-field { display: flex; align-items: center; gap: 22rpx; }
.avatar-picker { display: flex; align-items: center; justify-content: center; width: 84rpx; height: 84rpx; padding: 0; border: 2rpx dashed #cedacc; border-radius: 50%; background: transparent; color: #9dac9e; font-size: 42rpx; overflow: hidden; }
.avatar-preview { width: 100%; height: 100%; }
.form-field { margin-top: 22rpx; }
.field-label { display: block; font-size: 25rpx; font-weight: 650; margin-bottom: 10rpx; }
.avatar-field .field-label { margin-bottom: 0; }
.input-shell { width: 100%; background: #fff; }
.demo-code { display: block; color: var(--muted); font-size: 21rpx; margin-top: 10rpx; }
.continue-button { margin-top: 24rpx; height: 86rpx; }
.privacy-note { display: block; margin-top: 20rpx; color: var(--muted); text-align: center; font-size: 20rpx; line-height: 1.6; }
.onboarding .avatar-picker { width: 84rpx; min-width: 84rpx; max-width: 84rpx; flex: 0 0 84rpx; box-sizing: border-box; } .onboarding .continue-button { width: 100%; min-width: 100%; max-width: 100%; box-sizing: border-box; }
.form-error { display: block; margin: 18rpx 0; color: #b3614c; font-size: 24rpx; line-height: 1.6; }
