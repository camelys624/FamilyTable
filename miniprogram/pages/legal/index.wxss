.legal-tabs { display: flex; gap: 16rpx; margin-bottom: 22rpx; }
.legal-tabs button { flex: 1; color: var(--ink); background: #fffefb; }
.legal-tabs .active { color: #fff; background: var(--ink); }
.legal-card { padding: 28rpx; }
.legal-card > text { display: block; margin-top: 16rpx; font-size: 26rpx; line-height: 1.9; overflow-wrap: anywhere; }
.legal-card .legal-heading { font-size: 30rpx; font-weight: 650; margin-top: 32rpx; }
.legal-card .secondary-button { margin-top: 24rpx; font-size: 25rpx; }
