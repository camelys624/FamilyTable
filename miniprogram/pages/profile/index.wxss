.profile-page { padding: 28rpx 28rpx 40rpx; }

/* ---------- 顶部 ---------- */
.family-banner { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; min-height: 190rpx; margin-bottom: 24rpx; }
.family-heading { flex: 1; min-width: 0; }
.family-title { margin-top: 12rpx; font-size: 44rpx; font-weight: 700; line-height: 1.3; overflow-wrap: anywhere; }
.family-caption { display: block; margin-top: 12rpx; color: var(--muted); font-size: 24rpx; line-height: 1.5; }
.family-art { flex: none; width: 190rpx; height: 190rpx; overflow: visible; }
.demo-note { display: block; margin-top: 12rpx; color: var(--muted); font-size: 24rpx; }

/* ---------- 卡片 ---------- */
.member-card, .preference-card, .invitation-card { padding: 28rpx; margin-bottom: 22rpx; }
.card-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.card-heading > view { flex: 1; min-width: 0; }
.card-title { display: block; color: var(--ink); font-size: 30rpx; font-weight: 650; line-height: 1.4; }
.card-caption { display: block; margin-top: 8rpx; color: var(--muted); font-size: 24rpx; font-weight: 400; line-height: 1.5; }

/* 邀请家人：页面主操作，实心深色 */
.profile-page button.invite-button {
  display: flex; align-items: center; justify-content: center; flex: none;
  min-width: 168rpx; min-height: 72rpx; margin: 0; padding: 10rpx 22rpx; box-sizing: border-box;
  border-radius: 999rpx; background: var(--ink); color: #fffefb; font-size: 24rpx; font-weight: 600; line-height: 1.5;
}

/* ---------- 家人 ---------- */
.profile-tip { display: flex; align-items: flex-start; gap: 10rpx; margin-top: 20rpx; padding: 16rpx 18rpx; border-radius: 18rpx; background: #fdf6e6; }
.profile-tip-mark { flex: none; width: 30rpx; height: 30rpx; margin-top: 2rpx; border-radius: 50%; background: var(--yolk); color: #6b4a10; font-size: 21rpx; font-weight: 700; line-height: 30rpx; text-align: center; }
.profile-tip-text { flex: 1; min-width: 0; color: #7b5a18; font-size: 24rpx; line-height: 1.5; }

.member-list { margin-top: 12rpx; }
.member-row { display: flex; align-items: center; gap: 18rpx; min-height: 108rpx; padding: 14rpx 0; box-sizing: border-box; }
.member-row + .member-row { border-top: 1rpx solid #eef2ec; }

.member-avatar { position: relative; display: flex; align-items: center; justify-content: center; flex: none; width: 64rpx; height: 64rpx; border-radius: 50%; background: #f4ddd0; overflow: hidden; }
.member-blue { background: #dce9ec; }
.member-green { background: #e1ead5; }
.avatar-initial { font-size: 27rpx; font-weight: 650; color: #4a5750; }

/* 统一默认头像：不再拿「微」字冒充头像 */
.member-avatar.is-fallback::before { content: ''; position: absolute; left: 50%; top: 14rpx; width: 22rpx; height: 22rpx; margin-left: -11rpx; border-radius: 50%; background: rgba(74, 87, 80, 0.55); }
.member-avatar.is-fallback::after { content: ''; position: absolute; left: 50%; bottom: -8rpx; width: 42rpx; height: 30rpx; margin-left: -21rpx; border-radius: 30rpx 30rpx 0 0; background: rgba(74, 87, 80, 0.55); }

.member-copy { display: flex; align-items: center; gap: 10rpx; flex: 1; min-width: 0; }
.member-name { min-width: 0; font-size: 27rpx; font-weight: 600; overflow-wrap: anywhere; }
.me-label { flex: none; padding: 2rpx 10rpx; border-radius: 8rpx; color: var(--muted); background: #f0f3ed; font-size: 21rpx; }

/* 角色统一成标签：家长琥珀，成员中性灰 */
.role-tag { flex: none; padding: 8rpx 16rpx; border-radius: 999rpx; font-size: 24rpx; font-weight: 600; line-height: 1.2; }
.role-owner { color: #91611a; background: #fff0c9; }
.role-member { color: var(--muted); background: #f1f4ef; }

.member-guide { display: block; margin-top: 16rpx; color: var(--muted); font-size: 24rpx; line-height: 1.5; }

/* ---------- 我的口味：下拉行 ---------- */
.preference-heading { margin-bottom: 8rpx; }
.private-label { flex: none; color: var(--muted); font-size: 24rpx; font-weight: 400; }

.pick { border-top: 1rpx solid #eef2ec; }
.preference-heading + .pick { border-top: 0; }

.pick-row { display: flex; align-items: center; gap: 12rpx; min-height: 108rpx; }
.pick-label { flex: none; color: var(--ink); font-size: 27rpx; font-weight: 600; }
.pick-value { flex: 1; min-width: 0; color: #4f5c55; font-size: 25rpx; text-align: right; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.pick-value.is-empty { color: #8a978f; }
.pick-value.is-warn { color: #b3553f; font-weight: 600; }
.pick-arrow { flex: none; width: 16rpx; height: 16rpx; margin-left: 4rpx; border-right: 2rpx solid #90a096; border-bottom: 2rpx solid #90a096; transform: rotate(45deg) translateY(-3rpx); transition: transform 0.2s ease; }
.pick.is-open .pick-arrow { transform: rotate(-135deg) translateY(-2rpx); }

.pick-tags { display: flex; flex-wrap: wrap; gap: 10rpx; padding: 0 0 20rpx; }
.pick-tag { display: flex; align-items: center; height: 56rpx; padding: 0 16rpx; border-radius: 12rpx; background: #eef4ee; color: #2f6b4f; font-size: 23rpx; }
.pick-tag-x { margin-left: 10rpx; color: #7d9b8b; font-size: 26rpx; line-height: 1; }

.pick-panel { padding: 4rpx 0 22rpx; }
/* scroll-view 需要确定高度才能滚动，max-height 在部分基础库上会失效。 */
.pick-scroll { height: 420rpx; }
.pick-opt { display: flex; align-items: center; gap: 12rpx; min-height: 88rpx; padding: 0 22rpx; border-radius: 16rpx; background: #f6f8f3; color: var(--ink); font-size: 26rpx; }
.pick-opt + .pick-opt { margin-top: 6rpx; }
.pick-opt.is-checked { background: var(--ink); color: #fffefb; }
.pick-opt-name { flex: 1; min-width: 0; }
.pick-opt-check { flex: none; width: 24rpx; height: 13rpx; border-left: 3rpx solid #fffefb; border-bottom: 3rpx solid #fffefb; transform: rotate(-45deg) translateY(-2rpx); }
.pick-heat { display: flex; align-items: center; gap: 5rpx; }
.heat-dot { width: 9rpx; height: 9rpx; border-radius: 50%; background: var(--chili); opacity: 0.75; }
.pick-opt.is-checked .heat-dot { background: #ffd9c9; opacity: 1; }

.pick-custom { display: flex; align-items: center; gap: 12rpx; margin-top: 16rpx; }
.custom-input { flex: 1; min-width: 0; height: 84rpx; padding: 0 20rpx; box-sizing: border-box; border: 1rpx solid #dde5da; border-radius: 16rpx; background: #fffefb; font-size: 25rpx; }
.custom-add { flex: none; height: 84rpx; padding: 0 26rpx; border-radius: 16rpx; background: #eef3e9; color: #7d8c83; font-size: 25rpx; font-weight: 600; line-height: 84rpx; }
.custom-add.is-on { background: var(--ink); color: #fffefb; }

/* 过敏原：红色系，与「不爱吃」区分开 */
.pick-danger .pick-label { color: #b3553f; }
.pick-danger .pick-tag { background: #fbeae6; color: #a8442f; }
.pick-danger .pick-tag-x { color: #c08a7d; }
.pick-danger .pick-opt.is-checked { background: #c0503a; color: #fff; }
.pick-danger .custom-add.is-on { background: #c0503a; color: #fff; }
.pick-note { display: block; margin-top: 14rpx; color: #8a6258; font-size: 23rpx; line-height: 1.5; }

/* 保存：没改动就是灰的 */
.profile-page button.save-preference {
  display: flex; align-items: center; justify-content: center;
  width: 100%; height: 88rpx; margin: 24rpx 0 0; padding: 0;
  border-radius: 20rpx; background: #e9ede7; color: #93a096; font-size: 26rpx; font-weight: 600; line-height: 1.5;
}
.profile-page button.save-preference.is-dirty { background: var(--ink); color: #fffefb; }
.save-error { display: block; margin-top: 20rpx; padding: 16rpx 18rpx; border-radius: 16rpx; background: #fbefeb; color: #a8442f; font-size: 24rpx; line-height: 1.55; }

/* ---------- 菜单：只留一个「设置」入口，协议与反馈收进设置页 ---------- */
.menu-card { margin-bottom: 22rpx; padding: 0 28rpx; }
.menu-row { display: flex; align-items: center; gap: 22rpx; min-height: 128rpx; padding: 20rpx 0; box-sizing: border-box; }
.menu-row-hover { opacity: 0.6; }

/* 设置图标：三条滑杆，纯 CSS，跟页面的描线风格一致 */
.menu-icon { display: flex; flex-direction: column; justify-content: center; gap: 10rpx; flex: none; width: 76rpx; height: 76rpx; padding: 0 18rpx; box-sizing: border-box; border-radius: 22rpx; background: #e7f0e6; }
.slider-line { position: relative; height: 4rpx; border-radius: 4rpx; background: #7fa48d; }
.slider-knob { position: absolute; top: 50%; width: 12rpx; height: 12rpx; margin-top: -8rpx; border: 2rpx solid #347a5d; border-radius: 50%; background: #fffefb; }
.knob-a { left: 4rpx; }
.knob-b { right: 4rpx; }
.knob-c { left: 14rpx; }

.menu-copy { flex: 1; min-width: 0; }
.menu-label { display: block; color: var(--ink); font-size: 29rpx; font-weight: 650; line-height: 1.4; }
.menu-caption { display: block; margin-top: 6rpx; color: var(--muted); font-size: 23rpx; line-height: 1.5; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.menu-arrow { flex: none; width: 16rpx; height: 16rpx; margin-right: 6rpx; border-right: 2rpx solid #b3bfb7; border-bottom: 2rpx solid #b3bfb7; transform: rotate(-45deg); }

/* ---------- 邀请码 ---------- */
.invite-chip { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.invite-code { display: block; margin-top: 6rpx; color: var(--ink); font-size: 32rpx; font-weight: 650; letter-spacing: 4rpx; }
.copy-label { flex: none; padding: 12rpx 18rpx; border-radius: 999rpx; background: #eef3e9; color: #347a5d; font-size: 24rpx; }
.invite-guide { display: block; margin-top: 18rpx; color: var(--muted); font-size: 24rpx; line-height: 1.6; }
.invite-footer { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin-top: 10rpx; }
.profile-page button.rotate-invite { flex: none; width: auto; margin: 0; padding: 8rpx 0 8rpx 16rpx; background: transparent; color: #347a5d; font-size: 24rpx; font-weight: 500; line-height: 1.5; }

/* ---------- 错误 ---------- */
.family-error, .preference-error { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; color: #b3614c; font-size: 24rpx; line-height: 1.6; }
.family-error { margin-bottom: 22rpx; padding: 24rpx 28rpx; }
.preference-error { margin-bottom: 20rpx; padding-top: 18rpx; border-top: 1rpx solid #eef2ec; }
.profile-page .family-error button, .profile-page .preference-error button { flex: none; width: auto; margin: 0; padding: 8rpx 16rpx; border-radius: 12rpx; background: #eef3e9; color: var(--ink); font-size: 24rpx; line-height: 1.6; }
