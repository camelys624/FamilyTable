.profile-page { padding: 28rpx 28rpx 40rpx; }
.family-banner { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; min-height: 190rpx; margin-bottom: 24rpx; }
.family-heading { flex: 1; min-width: 0; }
.family-title { margin-top: 12rpx; font-size: 44rpx; font-weight: 700; line-height: 1.3; overflow-wrap: anywhere; }
.family-caption { display: block; margin-top: 12rpx; color: var(--muted); font-size: 22rpx; line-height: 1.5; }
.family-art { flex: none; width: 182rpx; height: 182rpx; }
.demo-note { display: block; margin-top: 12rpx; color: var(--muted); font-size: 21rpx; }
.member-card, .preference-card, .invitation-card { padding: 28rpx; margin-bottom: 22rpx; }
.card-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.card-heading > view { flex: 1; min-width: 0; }
.card-title { display: block; color: var(--ink); font-size: 30rpx; font-weight: 650; line-height: 1.4; }
.card-caption { display: block; margin-top: 8rpx; color: var(--muted); font-size: 21rpx; font-weight: 400; line-height: 1.5; }
.profile-page button.invite-button { display: flex; align-items: center; justify-content: center; flex: none; width: 164rpx; min-height: 62rpx; margin: 0; padding: 8rpx 12rpx; box-sizing: border-box; border-radius: 999rpx; background: #eef3e9; color: #347a5d; font-size: 22rpx; font-weight: 500; line-height: 1.5; }
.member-list { margin-top: 22rpx; }
.member-row { display: flex; align-items: center; gap: 18rpx; min-height: 96rpx; }
.member-row + .member-row { border-top: 1rpx solid #edf1eb; }
.member-avatar { display: flex; align-items: center; justify-content: center; flex: none; width: 62rpx; height: 62rpx; border-radius: 50%; background: #f4ddd0; font-size: 27rpx; font-weight: 650; }
.member-blue { background: #dce9ec; }
.member-green { background: #e1ead5; }
.member-copy { display: flex; align-items: center; gap: 10rpx; flex: 1; min-width: 0; }
.member-name { min-width: 0; font-size: 26rpx; font-weight: 600; overflow-wrap: anywhere; }
.me-label { flex: none; padding: 3rpx 8rpx; border-radius: 8rpx; color: var(--muted); background: #f0f3ed; font-size: 18rpx; }
.member-role { flex: none; color: var(--muted); font-size: 21rpx; }
.parent-role { padding: 7rpx 14rpx; border-radius: 999rpx; color: #9b691c; background: #fff0c9; }
.member-guide { display: block; margin-top: 16rpx; color: var(--muted); font-size: 21rpx; }
.private-label { flex: none; color: var(--muted); font-size: 21rpx; font-weight: 400; }
.preference-heading { margin-bottom: 26rpx; }
.field-label { display: block; margin-bottom: 14rpx; font-size: 24rpx; font-weight: 500; }
.spicy-options { display: flex; gap: 12rpx; }
.profile-page button.spicy-option { display: flex; align-items: center; justify-content: center; flex: 1; width: 0; height: 70rpx; margin: 0; padding: 0; border: 1rpx solid #e1e8de; border-radius: 16rpx; background: #f7f9f4; color: var(--muted); font-size: 24rpx; font-weight: 400; line-height: 1.5; }
.profile-page button.spicy-option.selected { background: #e6eee2; border-color: #91ae91; color: #2e6549; font-weight: 650; }
.avoid-field { margin-top: 26rpx; }
.avoid-input { width: 100%; height: 78rpx; padding: 0 20rpx; box-sizing: border-box; border: 1rpx solid #dde5da; border-radius: 16rpx; background: #fffefb; font-size: 25rpx; }
.profile-page button.save-preference { display: flex; align-items: center; justify-content: center; width: 100%; height: 74rpx; margin: 24rpx 0 0; padding: 0; border-radius: 18rpx; background: var(--ink); color: #fff; font-size: 25rpx; font-weight: 600; line-height: 1.5; }
.profile-page button.settings-button { display: flex; align-items: center; justify-content: space-between; width: 100%; min-height: 118rpx; margin: 0; padding: 22rpx 28rpx; box-sizing: border-box; border-radius: 30rpx; background: transparent; text-align: left; line-height: 1.5; }
.settings-copy { flex: 1; min-width: 0; }
.settings-title { display: block; color: var(--ink); font-size: 28rpx; font-weight: 600; }
.settings-arrow { margin-left: 24rpx; color: #809385; font-size: 38rpx; font-weight: 400; }
.invite-chip { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.invite-code { display: block; margin-top: 6rpx; color: var(--ink); font-size: 32rpx; font-weight: 650; letter-spacing: 4rpx; }
.copy-label { flex: none; padding: 12rpx 18rpx; border-radius: 999rpx; background: #eef3e9; color: #347a5d; font-size: 21rpx; }
.invite-guide { display: block; margin-top: 18rpx; color: var(--muted); font-size: 22rpx; line-height: 1.6; }
.invite-footer { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin-top: 10rpx; }
.profile-page button.rotate-invite { flex: none; width: auto; margin: 0; padding: 8rpx 0 8rpx 16rpx; background: transparent; color: #347a5d; font-size: 21rpx; font-weight: 500; line-height: 1.5; }
.family-error, .preference-error { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; color: #b3614c; font-size: 23rpx; line-height: 1.6; }
.family-error { margin-bottom: 22rpx; padding: 24rpx 28rpx; }
.preference-error { margin-bottom: 20rpx; }
.profile-page .family-error button, .profile-page .preference-error button { flex: none; width: auto; margin: 0; padding: 8rpx 16rpx; border-radius: 12rpx; background: #eef3e9; color: var(--ink); font-size: 21rpx; line-height: 1.6; }
