.family-banner { min-height: 194rpx; margin-bottom: 8rpx; }
.family-banner .page-title { font-size: 48rpx; }
.family-banner .design-copy { padding-right: 180rpx; }
.demo-note { display: block; margin-top: 6rpx; font-size: 21rpx; color: var(--muted); }
.invite-chip { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding: 18rpx 22rpx; border-radius: 20rpx; background: #fffefb; margin-bottom: 22rpx; font-size: 23rpx; color: var(--muted); }
.invite-code { color: var(--ink); margin-left: 12rpx; font-weight: 650; }
.copy-label { border-radius: 999rpx; background: #eef3e9; color: var(--ink); padding: 10rpx 18rpx; font-size: 21rpx; }
.member-card, .preference-card { padding: 22rpx 24rpx; margin-bottom: 20rpx; }
.member-card .design-note, .preference-card .design-note { margin-top: 6rpx; }
.invite-button { display: flex; align-items: center; min-height: 66rpx; padding: 0 22rpx; color: #fff; background: var(--ink); border-radius: 20rpx; font-size: 24rpx; flex: none; }
.member-row { display: flex; align-items: center; gap: 18rpx; padding: 16rpx 0; border-top: 1rpx solid #e7eee5; }
.member-avatar { display: flex; align-items: center; justify-content: center; width: 74rpx; height: 74rpx; border-radius: 50%; background: #f4ddd0; font-weight: 700; font-size: 28rpx; flex: none; }
.member-blue { background: #dce9ec; }
.member-green { background: #e1ead5; }
.member-copy { min-width: 0; flex: 1; }
.member-name { display: block; font-size: 27rpx; font-weight: 650; }
.member-note { display: block; font-size: 21rpx; color: var(--muted); margin-top: 6rpx; }
.preference-row { display: flex; align-items: center; justify-content: space-between; }
.preference-label { font-size: 26rpx; font-weight: 650; }
.preference-card slider { margin: 18rpx 0 8rpx; }
.spicy-labels { display: flex; justify-content: space-between; font-size: 21rpx; color: var(--muted); }
.avoid-field { display: flex; flex-wrap: wrap; align-items: center; gap: 12rpx; border-top: 1rpx solid #e7eee5; margin-top: 22rpx; padding-top: 18rpx; }
.avoid-input-row { display: flex; flex: 1; gap: 10rpx; min-width: 200rpx; }
.avoid-input-row input { flex: 1; min-width: 0; padding: 0 14rpx; height: 70rpx; box-sizing: border-box; background: #fff; border: 1rpx solid var(--line); border-radius: 16rpx; font-size: 24rpx; }
.avoid-input-row button { width: 108rpx; height: 70rpx; padding: 0; display: flex; align-items: center; justify-content: center; background: var(--ink); color: #fff; border-radius: 16rpx; font-size: 23rpx; flex: none; }
.settings-list { padding: 0 24rpx; }
.settings-row { display: flex; align-items: center; justify-content: space-between; min-height: 88rpx; gap: 12rpx; font-size: 25rpx; }
.settings-row + .settings-row { border-top: 1rpx solid #e7eee5; }
.settings-value { color: #347a5d; font-size: 23rpx; }
.settings-row.danger { color: #b3614c; }
.version-text { display: block; text-align: center; margin-top: 22rpx; font-size: 20rpx; color: #8c988f; }
.invitation-card { padding: 20rpx 24rpx; margin-bottom: 20rpx; }
.invitation-card .invite-chip { padding: 0; margin-bottom: 14rpx; }
.invite-code { font-size: 30rpx; letter-spacing: 3rpx; }
.invite-guide { display: block; margin-top: 10rpx; color: var(--muted); font-size: 23rpx; line-height: 1.7; }
.rotate-invite { margin: 12rpx 0 0; padding: 0; text-align: left; background: transparent; color: #347a5d; font-size: 23rpx; }
.rotate-invite::after { border: 0; }
button.invite-button { width: 152rpx; margin: 0; justify-content: center; box-sizing: border-box; line-height: 1.4; font-weight: 500; }
.member-card .design-heading > view { flex: 1; min-width: 0; }
.family-error { display: flex; align-items: center; gap: 20rpx; padding: 24rpx; margin-bottom: 20rpx; color: #b3614c; font-size: 25rpx; }
.family-error button { flex: none; margin: 0; font-size: 23rpx; color: var(--ink); background: #eef3e9; }
