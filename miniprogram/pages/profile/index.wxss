.profile-page {
  padding-top: 28rpx;
}

.family-banner {
  position: relative;
  overflow: hidden;
  padding: 40rpx 36rpx 36rpx;
  border-radius: 38rpx;
  background: var(--ink);
  color: #ffffff;
}

.banner-pattern {
  position: absolute;
  right: -55rpx;
  top: -90rpx;
  width: 300rpx;
  height: 300rpx;
  border: 26rpx solid rgba(244, 201, 93, 0.15);
  border-radius: 50%;
}

.banner-pattern::after {
  content: '';
  position: absolute;
  left: 48rpx;
  top: 48rpx;
  width: 150rpx;
  height: 150rpx;
  border: 12rpx solid rgba(244, 201, 93, 0.13);
  border-radius: 50%;
}

.family-eyebrow {
  position: relative;
  color: var(--yolk);
}

.family-name {
  position: relative;
  margin-top: 10rpx;
  font-family: "STKaiti", "KaiTi", serif;
  font-size: 55rpx;
  font-weight: 900;
}

.family-meta {
  position: relative;
  display: block;
  margin-top: 9rpx;
  color: rgba(255, 255, 255, 0.66);
  font-size: 22rpx;
}

.invite-chip {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 32rpx;
  padding: 20rpx 23rpx;
  border: 2rpx dashed rgba(255, 255, 255, 0.35);
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.07);
  font-family: monospace;
  font-size: 22rpx;
}

.copy-label {
  color: var(--yolk);
  font-family: -apple-system, sans-serif;
  font-weight: 700;
}

.section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 42rpx;
}

.section-heading .subtle {
  display: block;
  margin-top: 5rpx;
}

.small-add {
  color: var(--leaf);
  font-size: 23rpx;
  font-weight: 750;
}

.member-list {
  margin-top: 18rpx;
  padding: 0 25rpx;
}

.member-row {
  display: flex;
  align-items: center;
  min-height: 116rpx;
  border-bottom: 2rpx solid #edf0ed;
}

.member-row:last-child {
  border-bottom: 0;
}

.member-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 66rpx;
  height: 66rpx;
  border-radius: 23rpx 23rpx 23rpx 7rpx;
  color: #ffffff;
  font-family: "STKaiti", "KaiTi", serif;
  font-size: 29rpx;
  font-weight: 800;
}

.member-red { background: var(--chili); }
.member-blue { background: #477a83; }
.member-green { background: var(--leaf); }

.member-copy {
  flex: 1;
  margin-left: 20rpx;
}

.member-name {
  display: block;
  font-weight: 750;
}

.member-role {
  display: block;
  margin-top: 5rpx;
  color: var(--muted);
  font-size: 20rpx;
}

.member-status {
  padding: 8rpx 13rpx;
  border-radius: 99rpx;
  background: var(--jade);
  color: var(--leaf);
  font-size: 19rpx;
}

.preference-heading {
  margin-top: 40rpx;
}

.preference-card {
  margin-top: 18rpx;
  padding: 28rpx;
}

.preference-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.preference-label {
  display: block;
  color: var(--muted);
  font-size: 22rpx;
  font-weight: 650;
}

.preference-value {
  display: block;
  margin-top: 5rpx;
  font-size: 30rpx;
  font-weight: 800;
}

.chili-scale {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  border-radius: 50% 50% 50% 12rpx;
  background: var(--chili);
  color: #ffffff;
  font-family: "STKaiti", "KaiTi", serif;
  font-weight: 800;
  transform: rotate(-8deg);
}

.preference-card slider {
  margin: 26rpx 0 0;
}

.avoid-field {
  margin-top: 25rpx;
  padding-top: 25rpx;
  border-top: 2rpx solid #edf0ed;
}

.avoid-input-row {
  display: flex;
  align-items: center;
  height: 74rpx;
  margin-top: 12rpx;
  padding: 0 20rpx;
  border-radius: 18rpx;
  background: var(--jade);
}

.avoid-input-row input {
  flex: 1;
}

.avoid-input-row text {
  color: var(--leaf);
  font-size: 22rpx;
  font-weight: 750;
}

.settings-list {
  margin-top: 30rpx;
  padding: 0 25rpx;
}

.settings-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 94rpx;
  border-bottom: 2rpx solid #edf0ed;
  font-size: 25rpx;
}

.settings-row:last-child {
  border-bottom: 0;
}

.settings-value {
  color: var(--leaf);
  font-size: 21rpx;
}

.settings-arrow {
  color: #9aa49e;
  font-size: 34rpx;
}

.settings-row.danger {
  color: var(--chili);
}

.version-text {
  display: block;
  margin-top: 34rpx;
  color: #9da8a1;
  font-family: monospace;
  font-size: 19rpx;
  text-align: center;
}
