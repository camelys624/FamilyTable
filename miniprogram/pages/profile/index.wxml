<view class="page-shell design-page profile-page">
  <view class="design-hero family-banner"><view class="design-copy"><text class="eyebrow">欢迎回家</text><view class="page-title">{{familyName || '家的小饭桌'}}</view><text class="design-note">{{familyMeta}}</text><text class="demo-note">本地体验家庭</text></view><view class="hero-picture"><kitchen-art kind="table" art-size="hero-illustration" size="228" /></view></view>
  <view class="invite-chip" bindtap="copyInviteCode"><text>体验邀请码 <text class="invite-code">{{inviteCode}}</text></text><text class="copy-label">复制</text></view>
  <view class="member-card paper-card"><view class="design-heading"><view><text class="section-title">饭桌上的家人</text><text class="design-note">本地体验成员示例</text></view><view class="invite-button" bindtap="addMember">＋ 邀请</view></view><view wx:for="{{members}}" wx:key="name" class="member-row"><view class="member-avatar {{item.tone}}">{{item.initial}}</view><view class="member-copy"><text class="member-name">{{item.name}}{{item.name === userName ? '（我）' : ''}}</text><text class="member-note">常在一起吃饭</text></view><text class="design-badge {{item.role === '管理员' ? 'amber' : ''}}">{{item.role}}</text></view></view>
  <view class="preference-card paper-card"><view class="design-heading"><view><text class="section-title">我的口味档案</text><text class="design-note">排餐时给家人一个提醒。</text></view><kitchen-art kind="chilli" art-size="small-illustration" size="100" /></view><view class="preference-row"><text class="preference-label">吃辣程度</text><text class="design-badge amber">{{spicyLabel}}</text></view><slider min="0" max="3" step="1" value="{{spicyLevel}}" activeColor="#d9a43d" backgroundColor="#e1e7df" block-color="#18332f" block-size="20" bindchange="onSpicyChange" /><view class="spicy-labels"><text>不辣</text><text>微辣</text><text>中辣</text><text>很辣</text></view><view class="avoid-field"><text class="preference-label">不爱吃／忌口</text><view class="avoid-input-row"><input value="{{avoidFood}}" bindinput="onAvoidInput" confirm-type="done" bindconfirm="saveAvoidFood" placeholder="例如：香菜、花生" /><button bindtap="saveAvoidFood">保存</button></view></view></view>
  <view class="settings-list paper-card"><view class="settings-row"><text>每周从周一开始</text><text class="settings-value">已开启</text></view><view class="settings-row"><text>隐私政策与用户协议</text></view><view class="settings-row danger" bindtap="resetDemo"><text>重置体验数据</text><text class="design-chevron">›</text></view></view><text class="version-text">家常 Family Table · MVP 1.0</text>
</view>
