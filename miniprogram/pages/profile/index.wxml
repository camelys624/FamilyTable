<view class="page-shell design-page profile-page">
  <view class="family-banner">
    <view class="family-heading">
      <text class="eyebrow">欢迎回家</text>
      <view class="family-title">{{familyName || '家的小饭桌'}}</view>
      <text class="family-caption">{{familyMeta || (loading ? '正在打开家庭…' : '和家人一起，好好吃饭')}}</text>
      <text wx:if="{{isLocal}}" class="demo-note">本地体验家庭</text>
    </view>
    <view class="family-art"><kitchen-art kind="table" size="182" /></view>
  </view>

  <view wx:if="{{familyError}}" class="family-error paper-card">
    <text>{{familyError}}</text>
    <button bindtap="loadFamily" loading="{{loading}}" disabled="{{loading}}">重新加载</button>
  </view>

  <view wx:if="{{!familyError}}" class="member-card paper-card">
    <view class="card-heading">
      <view><text class="card-title">饭桌上的家人</text><text class="card-caption">共享菜谱、菜单和冰箱</text></view>
      <button wx:if="{{canInvite}}" class="invite-button" bindtap="addMember" loading="{{inviting}}" disabled="{{inviting || loading}}">{{inviting ? '生成中' : (inviteCode ? '复制邀请' : '＋ 邀请家人')}}</button>
    </view>
    <view class="member-list">
      <view wx:for="{{members}}" wx:key="id" class="member-row">
        <view class="member-avatar {{item.tone}}">{{item.initial}}</view>
        <view class="member-copy"><text class="member-name">{{item.name}}</text><text wx:if="{{item.isMe}}" class="me-label">我</text></view>
        <text class="member-role {{item.role === '家长' ? 'parent-role' : ''}}">{{item.role}}</text>
      </view>
    </view>
    <text wx:if="{{!canInvite && !loading}}" class="member-guide">邀请更多家人，请联系家长。</text>
    <text wx:if="{{loading && !members.length}}" class="member-guide">正在读取家人成员…</text>
  </view>

  <view wx:if="{{inviteCode}}" class="invitation-card paper-card">
    <view class="invite-chip" bindtap="copyInviteCode"><view><text class="card-caption">{{isLocal ? '体验邀请码' : '家庭邀请码'}}</text><text class="invite-code">{{inviteCode}}</text></view><text class="copy-label">复制邀请码</text></view>
    <text class="invite-guide">家人打开小程序，选择「加入家庭」后输入邀请码。</text>
    <view class="invite-footer"><text class="card-caption">{{inviteExpiryLabel}}（北京时间）</text><button wx:if="{{!isLocal}}" class="rotate-invite" bindtap="rotateInvitation" disabled="{{inviting}}">更换</button></view>
  </view>

  <view class="preference-card paper-card">
    <view class="card-heading preference-heading"><text class="card-title">我的口味</text><text class="private-label">仅自己可见</text></view>
    <view wx:if="{{preferenceError}}" class="preference-error"><text>{{preferenceError}}</text><button wx:if="{{!preferencePending}}" bindtap="loadPreferences" disabled="{{preferenceLoading}}">重新加载</button></view>
    <view class="preference-field">
      <text class="field-label">吃辣程度</text>
      <view class="spicy-options">
        <button class="spicy-option {{spicyLevel === 0 ? 'selected' : ''}}" data-level="0" bindtap="onSpicySelect" disabled="{{preferenceLoading || preferenceSaving || preferencePending || preferenceError}}">不辣</button>
        <button class="spicy-option {{spicyLevel === 1 ? 'selected' : ''}}" data-level="1" bindtap="onSpicySelect" disabled="{{preferenceLoading || preferenceSaving || preferencePending || preferenceError}}">微辣</button>
        <button class="spicy-option {{spicyLevel === 2 ? 'selected' : ''}}" data-level="2" bindtap="onSpicySelect" disabled="{{preferenceLoading || preferenceSaving || preferencePending || preferenceError}}">中辣</button>
        <button class="spicy-option {{spicyLevel === 3 ? 'selected' : ''}}" data-level="3" bindtap="onSpicySelect" disabled="{{preferenceLoading || preferenceSaving || preferencePending || preferenceError}}">很辣</button>
      </view>
    </view>
    <view class="preference-field avoid-field">
      <text class="field-label">不爱吃 / 忌口</text>
      <input class="avoid-input" disabled="{{preferenceLoading || preferenceSaving || preferencePending || preferenceError}}" value="{{avoidFood}}" bindinput="onAvoidInput" confirm-type="done" bindconfirm="saveAvoidFood" placeholder="例如：香菜、花生" />
    </view>
    <button class="save-preference" bindtap="saveAvoidFood" loading="{{preferenceSaving}}" disabled="{{preferenceLoading || preferenceSaving || (preferenceError && !preferencePending)}}">{{preferenceSaving ? '正在保存' : (preferencePending ? '重试上次保存' : '保存口味')}}</button>
    <text wx:if="{{isLocal}}" class="demo-note">本地体验口味档案</text>
  </view>

  <view class="settings-entry paper-card">
    <button class="settings-button" bindtap="openSettings"><view class="settings-copy"><text class="settings-title">设置</text><text class="card-caption">饭桌信息 · 隐私与协议</text></view><text class="settings-arrow">›</text></button>
  </view>
</view>
