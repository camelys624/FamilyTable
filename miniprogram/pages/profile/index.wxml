<view class="page-shell design-page profile-page">
  <view class="family-banner">
    <view class="family-heading">
      <text class="eyebrow">欢迎回家</text>
      <view class="family-title">{{familyName || '家的小饭桌'}}</view>
      <text class="family-caption">{{familyMeta || (loading ? '正在打开家庭…' : '和家人一起，好好吃饭')}}</text>
      <text wx:if="{{isLocal}}" class="demo-note">本地体验家庭</text>
    </view>
    <view class="family-art"><kitchen-art kind="table" size="182" /></view>
  </view>

  <view wx:if="{{familyError}}" class="family-error paper-card">
    <text>{{familyError}}</text>
    <button bindtap="loadFamily" loading="{{loading}}" disabled="{{loading}}">重新加载</button>
  </view>

  <view wx:if="{{!familyError}}" class="member-card paper-card">
    <view class="card-heading">
      <view><text class="card-title">饭桌上的家人</text><text class="card-caption">共享菜谱、菜单和冰箱</text></view>
      <button wx:if="{{canInvite}}" class="invite-button" bindtap="addMember" loading="{{inviting}}" disabled="{{inviting || loading}}">{{inviting ? '生成中' : (inviteCode ? '复制邀请' : '＋ 邀请家人')}}</button>
    </view>

    <view wx:if="{{needProfileTip}}" class="profile-tip">
      <text class="profile-tip-mark">!</text>
      <text class="profile-tip-text">还没有设置昵称，家人列表里只会显示「我」。</text>
    </view>

    <view class="member-list">
      <view wx:for="{{members}}" wx:key="id" class="member-row">
        <view class="member-avatar {{item.tone}} {{item.isFallback ? 'is-fallback' : ''}}">
          <text wx:if="{{item.initial}}" class="avatar-initial">{{item.initial}}</text>
        </view>
        <view class="member-copy">
          <text class="member-name">{{item.name}}</text>
          <text wx:if="{{item.isMe}}" class="me-label">我</text>
        </view>
        <text class="role-tag {{item.role === '家长' ? 'role-owner' : 'role-member'}}">{{item.role}}</text>
      </view>
    </view>

    <text wx:if="{{!canInvite && !loading}}" class="member-guide">邀请更多家人，请联系家长。</text>
    <text wx:if="{{loading && !members.length}}" class="member-guide">正在读取家人成员…</text>
  </view>

  <view wx:if="{{inviteCode}}" class="invitation-card paper-card">
    <view class="invite-chip" bindtap="copyInviteCode"><view><text class="card-caption">{{isLocal ? '体验邀请码' : '家庭邀请码'}}</text><text class="invite-code">{{inviteCode}}</text></view><text class="copy-label">复制邀请码</text></view>
    <text class="invite-guide">家人打开小程序，选择「加入家庭」后输入邀请码。</text>
    <view class="invite-footer"><text class="card-caption">{{inviteExpiryLabel}}（北京时间）</text><button wx:if="{{!isLocal}}" class="rotate-invite" bindtap="rotateInvitation" disabled="{{inviting}}">更换</button></view>
  </view>

  <view class="preference-card paper-card">
    <view class="card-heading preference-heading">
      <view><text class="card-title">我的口味</text><text class="card-caption">点开选择，也可以自己填</text></view>
      <text class="private-label">仅自己可见</text>
    </view>

    <view wx:if="{{preferenceError}}" class="preference-error"><text>{{preferenceError}}</text><button bindtap="loadPreferences" disabled="{{preferenceLoading}}">重新加载</button></view>

    <view class="pick {{openPicker === 'dislike' ? 'is-open' : ''}}">
      <view class="pick-row" bindtap="togglePicker" data-key="dislike">
        <text class="pick-label">不爱吃</text>
        <text class="pick-value {{dislikes.length ? '' : 'is-empty'}}">{{dislikes.length ? dislikes.length + ' 项' : '未填写'}}</text>
        <view class="pick-arrow"></view>
      </view>

      <view wx:if="{{dislikes.length}}" class="pick-tags">
        <view class="pick-tag" wx:for="{{dislikes}}" wx:key="*this" data-key="dislike" data-value="{{item}}" bindtap="removeTag">
          <text>{{item}}</text><text class="pick-tag-x">×</text>
        </view>
      </view>

      <view wx:if="{{openPicker === 'dislike'}}" class="pick-panel">
        <scroll-view class="pick-scroll" scroll-y>
          <view class="pick-opt {{item.checked ? 'is-checked' : ''}}" wx:for="{{dislikeOptions}}" wx:key="name" data-key="dislike" data-value="{{item.name}}" bindtap="toggleOption">
            <text class="pick-opt-name">{{item.name}}</text>
            <view wx:if="{{item.checked}}" class="pick-opt-check"></view>
          </view>
        </scroll-view>
        <view class="pick-custom">
          <input class="custom-input" value="{{dislikeDraft}}" data-key="dislike" bindinput="onDraftInput" bindconfirm="addCustom" confirm-type="done" maxlength="12" placeholder="其他不吃的，如：苦瓜" />
          <view class="custom-add {{dislikeDraft ? 'is-on' : ''}}" data-key="dislike" bindtap="addCustom">添加</view>
        </view>
      </view>
    </view>

    <view class="pick pick-danger {{openPicker === 'allergen' ? 'is-open' : ''}}">
      <view class="pick-row" bindtap="togglePicker" data-key="allergen">
        <text class="pick-label">过敏原</text>
        <text class="pick-value {{allergies.length ? 'is-warn' : 'is-empty'}}">{{allergies.length ? allergies.length + ' 项' : '未填写'}}</text>
        <view class="pick-arrow"></view>
      </view>

      <view wx:if="{{allergies.length}}" class="pick-tags">
        <view class="pick-tag" wx:for="{{allergies}}" wx:key="*this" data-key="allergen" data-value="{{item}}" bindtap="removeTag">
          <text>{{item}}</text><text class="pick-tag-x">×</text>
        </view>
      </view>

      <view wx:if="{{openPicker === 'allergen'}}" class="pick-panel">
        <scroll-view class="pick-scroll" scroll-y>
          <view class="pick-opt {{item.checked ? 'is-checked' : ''}}" wx:for="{{allergenOptions}}" wx:key="name" data-key="allergen" data-value="{{item.name}}" bindtap="toggleOption">
            <text class="pick-opt-name">{{item.name}}</text>
            <view wx:if="{{item.checked}}" class="pick-opt-check"></view>
          </view>
        </scroll-view>
        <view class="pick-custom">
          <input class="custom-input" value="{{allergenDraft}}" data-key="allergen" bindinput="onDraftInput" bindconfirm="addCustom" confirm-type="done" maxlength="12" placeholder="其他过敏原，如：小米" />
          <view class="custom-add {{allergenDraft ? 'is-on' : ''}}" data-key="allergen" bindtap="addCustom">添加</view>
        </view>
        <text class="pick-note">过敏原会单独保存，排菜单时优先排除；严重的过敏请务必填写。</text>
      </view>
    </view>

    <view class="pick {{openPicker === 'spicy' ? 'is-open' : ''}}">
      <view class="pick-row" bindtap="togglePicker" data-key="spicy">
        <text class="pick-label">吃辣程度</text>
        <text class="pick-value">{{spicyLabel}}</text>
        <view class="pick-arrow"></view>
      </view>
      <view wx:if="{{openPicker === 'spicy'}}" class="pick-panel">
        <view class="pick-opt {{item.level === spicyLevel ? 'is-checked' : ''}}" wx:for="{{spicyOptions}}" wx:key="level" data-level="{{item.level}}" bindtap="pickSpicy">
          <text class="pick-opt-name">{{item.label}}</text>
          <view class="pick-heat"><view class="heat-dot" wx:for="{{item.dots}}" wx:for-item="dot" wx:key="*this"></view></view>
          <view wx:if="{{item.level === spicyLevel}}" class="pick-opt-check"></view>
        </view>
      </view>
    </view>

    <text wx:if="{{preferenceSaveError}}" class="save-error">{{preferencePending ? '保存结果还没确认。网络恢复后点「重试上次保存」，不会重复保存。' : preferenceSaveError}}</text>
    <button class="save-preference {{dirty ? 'is-dirty' : ''}}" bindtap="onSave" loading="{{preferenceSaving}}" disabled="{{preferenceLoading || preferenceSaving || !canSave || preferenceError}}">{{preferenceSaving ? '正在保存' : (preferencePending ? '重试上次保存' : (dirty ? '保存口味' : '暂无修改'))}}</button>
    <text wx:if="{{isLocal}}" class="demo-note">本地体验口味档案</text>
  </view>

  <view class="menu-card paper-card">
    <view class="menu-row" bindtap="openSettings" hover-class="menu-row-hover">
      <view class="menu-icon">
        <view class="slider-line"><view class="slider-knob knob-a"></view></view>
        <view class="slider-line"><view class="slider-knob knob-b"></view></view>
        <view class="slider-line"><view class="slider-knob knob-c"></view></view>
      </view>
      <view class="menu-copy">
        <text class="menu-label">设置</text>
        <text class="menu-caption">饭桌信息 · 隐私政策 · 用户协议 · 意见反馈</text>
      </view>
      <view class="menu-arrow"></view>
    </view>
  </view>
</view>
