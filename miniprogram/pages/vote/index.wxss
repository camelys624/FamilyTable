.vote-page .design-copy { padding-right: 160rpx; }
.vote-page .page-title { font-size: 54rpx; }
.voter-row { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 14rpx; margin: 4rpx 0 24rpx; color: var(--muted); font-size: 23rpx; }
.voter-avatars { display: flex; gap: 10rpx; }
.voter-avatar { display: flex; align-items: center; justify-content: center; width: 62rpx; height: 62rpx; border: 4rpx solid #fffefb; border-radius: 50%; font-weight: 650; background: #f5ddce; }
.voter-two { background: #dcecf1; }
.voter-three { background: #f1e4bd; }
.vote-card { padding: 20rpx 24rpx 18rpx; margin-bottom: 20rpx; }
.vote-card.selected { box-shadow: inset 0 0 0 2rpx #9fbdab; }
.candidate-heading { display: flex; align-items: center; gap: 16rpx; }
.candidate-picture { width: 132rpx; height: 132rpx; flex: none; border-radius: 20rpx; background: #faf5e8; overflow: hidden; }
.candidate-photo { width: 100%; height: 100%; }
.candidate-copy { flex: 1; min-width: 0; }
.candidate-name { display: block; font-size: 29rpx; font-weight: 750; overflow-wrap: anywhere; }
.candidate-meta { display: block; margin-top: 12rpx; font-size: 22rpx; color: var(--muted); }
.selected-seal { flex: none; padding: 18rpx 16rpx; color: #fff; background: var(--ink); border-radius: 20rpx; font-size: 23rpx; }
.vote-circle { width: 42rpx; height: 42rpx; border: 2rpx solid #88988e; border-radius: 50%; flex: none; }
.vote-result { display: flex; align-items: center; gap: 18rpx; margin-top: 14rpx; }
.vote-number { font-size: 26rpx; font-weight: 650; flex: none; }
.vote-track { flex: 1; height: 18rpx; overflow: hidden; border-radius: 999rpx; background: #e6ebe6; }
.vote-fill { height: 100%; border-radius: inherit; background: #347a5d; }
.selected .vote-fill { background: var(--ink); }
.vote-percent { min-width: 62rpx; text-align: right; color: var(--muted); font-size: 23rpx; }
.candidate-note { display: block; margin-top: 12rpx; color: var(--muted); font-size: 22rpx; line-height: 1.5; }
.vote-tip { display: flex; align-items: center; gap: 22rpx; padding: 30rpx; font-weight: 650; font-size: 26rpx; line-height: 1.6; }
.note-leaf { color: #8d9d52; font-size: 48rpx; }
.poll-filter { display: flex; align-items: center; gap: 22rpx; padding: 18rpx 24rpx; margin-bottom: 22rpx; font-size: 24rpx; }
.poll-filter button { margin-left: auto; font-size: 22rpx; color: var(--ink); background: #eef3e9; }
.poll-action { margin: 24rpx 0; }
.poll-form { padding: 26rpx; margin-top: 24rpx; }
.poll-form .input-shell { margin: 22rpx 0; }
.poll-choice { display: flex; justify-content: space-between; padding: 22rpx 18rpx; margin-top: 12rpx; border: 2rpx solid var(--line); border-radius: 18rpx; font-size: 26rpx; }
.poll-choice.picked { border-color: var(--leaf); background: #eaf2ea; }
