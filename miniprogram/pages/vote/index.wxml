<view class="page-shell design-page vote-page">
  <view class="design-hero"><view class="design-copy"><text class="eyebrow">一人一票</text><view class="page-title">{{pollTitle || '一起商量吃什么'}}</view><text class="design-note">{{deadline}}</text></view><view class="hero-picture"><kitchen-art kind="soup" art-size="hero-illustration" size="228" /></view></view>
  <view class="poll-filter paper-card"><picker mode="date" value="{{targetDate}}" bindchange="onTargetDate" disabled="{{loading || saving || pending}}"><text>{{targetDate}} ›</text></picker><picker range="{{mealNames}}" value="{{mealIndex}}" bindchange="onMeal" disabled="{{loading || saving || pending}}"><text>{{mealNames[mealIndex]}} ›</text></picker><button bindtap="loadData" disabled="{{loading || saving}}">刷新</button></view>
  <view class="cloud-error-card paper-card" wx:if="{{loadError}}"><text class="cloud-error-message">{{loadError}}</text><button bindtap="loadData" disabled="{{loading}}">重新加载</button></view>
  <view class="cloud-error-card paper-card" wx:if="{{writeError}}"><text class="cloud-error-message">{{writeError}}</text><button wx:if="{{pending}}" bindtap="retryPending" disabled="{{saving || loading}}">重试上次操作</button></view>
  <view wx:if="{{loading}}" class="design-empty paper-card"><text class="subtle">正在查看家人的选择…</text></view>
  <block wx:elif="{{!loadError}}">
    <view class="voter-row"><view class="voter-avatars"><view wx:for="{{voters}}" wx:key="id" class="voter-avatar {{item.tone}}">{{item.initial}}</view></view><text>{{participantCount}} 位家人已参与 · 共 {{totalVotes}} 票</text></view>
    <view class="candidate-list"><view wx:for="{{candidates}}" wx:key="id" class="vote-card paper-card {{item.selected ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="vote"><view class="candidate-heading"><view class="candidate-picture"><kitchen-art name="{{item.name}}" art-size="dish-illustration" size="132" /></view><view class="candidate-copy"><text class="candidate-name">{{item.name}}</text><text class="candidate-meta">{{item.duration}} 分钟 · {{item.difficulty}}</text></view><text class="selected-seal" wx:if="{{item.selected}}">✓ 我的票</text><view class="vote-circle" wx:else></view></view><view class="vote-result"><text class="vote-number">{{item.votes}} 票</text><view class="vote-track"><view class="vote-fill" style="width: {{item.percent}}%;"></view></view><text class="vote-percent">{{item.percent}}%</text></view><text class="candidate-note">{{item.note}}</text></view></view>
    <view class="design-empty paper-card" wx:if="{{!pollId}}"><kitchen-art kind="book" art-size="empty-illustration" size="230" /><text class="section-title">这顿饭还没有投票</text><text class="subtle">{{canCreate ? '选择几道菜，请家人一起决定。' : '请管理员发起投票，再投出你的一票。'}}</text></view>
    <view class="vote-tip paper-card" wx:if="{{pollId}}"><text class="note-leaf">♧</text><text>{{status === 'closed' ? '投票已结束，结果已保留。' : votedRecipeId ? '你的选择已记下，不能重复投票。' : '轻点一道菜，投出你的一票。'}}</text></view>
    <button wx:if="{{canCreate && status === 'open'}}" class="secondary-button poll-action" bindtap="closePoll" disabled="{{saving || pending}}">结束当前投票</button>
    <button wx:if="{{canCreate && status !== 'open' && !showCreate}}" class="primary-button poll-action" bindtap="openCreate" disabled="{{saving || pending}}">发起新投票</button>
    <view wx:if="{{canCreate && showCreate && status !== 'open'}}" class="paper-card poll-form"><text class="section-title">请家人投一票</text><input class="input-shell" value="{{title}}" bindinput="onTitle" maxlength="80" disabled="{{saving || pending}}" placeholder="投票标题" /><picker mode="time" value="{{closeTime}}" bindchange="onCloseTime" disabled="{{saving || pending}}"><text class="subtle">截止：{{targetDate}} {{closeTime}}（北京时间） ›</text></picker><text class="design-note">选择 2～10 道候选菜</text><view wx:for="{{createCandidates}}" wx:key="id" data-id="{{item.id}}" bindtap="toggleCandidate" class="poll-choice {{item.selected ? 'picked' : ''}}"><text>{{item.name}}</text><text>{{item.selected ? '✓' : '＋'}}</text></view><button wx:if="{{createCandidates.length >= 2}}" class="primary-button poll-action" bindtap="createPoll" loading="{{saving}}" disabled="{{saving || pending}}">发起投票</button><view wx:else class="design-note">至少需要两道菜谱。<text bindtap="openRecipes">去菜谱簿添加 ›</text></view></view>
  </block>
</view>
