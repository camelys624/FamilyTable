<view class="page-shell design-page vote-page">
  <view class="design-hero"><view class="design-copy"><text class="eyebrow">一人一票</text><view class="page-title">晚餐听谁的？</view><text class="design-note">今晚 17:30 截止</text></view><view class="hero-picture"><kitchen-art kind="soup" art-size="hero-illustration" size="228" /></view></view>
  <view class="voter-row"><view class="voter-avatars"><view wx:for="{{voters}}" wx:key="name" class="voter-avatar {{item.tone}}">{{item.initial}}</view></view><text>{{participantCount}} 位家人已参与 · 共 {{totalVotes}} 票</text></view>
  <view class="candidate-list"><view wx:for="{{candidates}}" wx:key="id" class="vote-card paper-card {{item.selected ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="vote">
    <view class="candidate-heading"><view class="candidate-picture"><image wx:if="{{item.imagePath}}" src="{{item.imagePath}}" mode="aspectFill" class="candidate-photo" /><kitchen-art wx:else name="{{item.name}}" art-size="dish-illustration" size="132" /></view><view class="candidate-copy"><text class="candidate-name">{{item.name}}</text><text class="candidate-meta">{{item.duration}} 分钟 · {{item.difficulty}}</text></view><text class="selected-seal" wx:if="{{item.selected}}">✓ 我的票</text><view class="vote-circle" wx:else></view></view>
    <view class="vote-result"><text class="vote-number">{{item.votes}} 票</text><view class="vote-track"><view class="vote-fill" style="width: {{item.percent}}%;"></view></view><text class="vote-percent">{{item.percent}}%</text></view><text class="candidate-note">{{item.note}}</text>
  </view></view>
  <view class="design-empty paper-card" wx:if="{{!candidates.length}}"><kitchen-art kind="book" art-size="empty-illustration" size="230" /><text class="section-title">还没有可以投票的菜</text><text class="subtle">先往菜谱簿里记几道菜，再回来选今晚吃什么。</text><button class="secondary-button" bindtap="openRecipes">去菜谱簿</button></view>
  <view class="vote-tip paper-card" wx:if="{{candidates.length}}"><text class="note-leaf">♧</text><text>{{votedRecipeId ? '你的选择已记下，不能重复投票。' : '轻点一道菜，投出你的一票。'}}</text></view>
</view>
