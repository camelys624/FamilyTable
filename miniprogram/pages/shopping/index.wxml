<view class="page-shell design-page shopping-page">
  <view wx:if="{{loadError}}" class="cloud-error-card paper-card"><text class="cloud-error-message">{{loadError}}</text><button bindtap="loadData" disabled="{{loading}}">重新加载</button></view>
  <view wx:if="{{writeError}}" class="cloud-error-card paper-card"><text class="cloud-error-message">{{writeError}}</text><button wx:if="{{pending}}" bindtap="retryPending" disabled="{{saving || loading}}">重试上次操作</button></view>
  <view wx:if="{{loading}}" class="design-empty paper-card"><text class="subtle">正在查看本周采购单…</text></view>
  <view class="design-hero"><view class="design-copy"><text class="eyebrow">从菜单到菜篮子</text><view class="page-title">本周采购单</view><text class="design-note">按这周的菜单，准备需要的食材。</text></view><view class="hero-picture"><kitchen-art kind="shopping" art-size="hero-illustration" size="228" /></view></view>
  <view class="progress-card paper-card"><view class="progress-heading"><view><text class="progress-number">{{progress}}%</text><text> 已买齐</text></view><text class="subtle">{{checkedCount}} / {{total}} 项完成</text></view><view class="progress-line"><view class="progress-fill" style="width: {{progress}}%;"></view></view></view>
  <view class="summary-row"><button class="primary-button regenerate" bindtap="regenerate" disabled="{{saving || loading || pending || loadError}}">↻ 按菜单重新汇总</button><view class="stale-note" wx:if="{{stale}}" bindtap="regenerate" disabled="{{saving || loading || pending || loadError}}"><text>！周菜单有变化</text><text>点这里重新汇总 ›</text></view></view>
  <view class="quick-add paper-card"><text class="quick-plus">＋</text><input disabled="{{saving || loading || pending || loadError}}" value="{{newItem}}" bindinput="onNewItem" confirm-type="done" bindconfirm="addItem" placeholder="临时想起还要买…" maxlength="20" /><button class="quick-add-button" bindtap="addItem" disabled="{{saving || loading || pending || loadError}}">加入</button></view>
  <view class="shopping-group paper-card" wx:for="{{groups}}" wx:key="name"><view class="group-heading"><text class="group-name">{{item.name}}</text><text class="subtle">· {{item.items.length}} 项</text></view><view wx:for="{{item.items}}" wx:for-item="food" wx:key="id" class="shopping-item {{food.checked ? 'checked' : ''}}" data-id="{{food.id}}" bindtap="toggleItem"><view class="check-box">{{food.checked ? '✓' : ''}}</view><kitchen-art name="{{food.name}}" art-size="ingredient-illustration" size="82" /><text class="food-name">{{food.name}}</text></view></view>
  <view class="design-empty paper-card" wx:if="{{!total}}"><kitchen-art kind="shopping" art-size="empty-illustration" size="230" /><text class="section-title">菜篮子还是空的</text><text class="subtle">先安排周菜单，再回来汇总采购单。</text></view>
  <view class="design-toolbar" wx:if="{{checkedCount}}"><button class="secondary-button clear-button" bindtap="clearChecked" disabled="{{saving || loading || pending || loadError}}">清除已买好的 {{checkedCount}} 项</button></view>
</view>
