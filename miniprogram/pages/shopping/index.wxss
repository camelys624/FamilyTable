.progress-card { padding: 22rpx 24rpx; }
.progress-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; font-size: 25rpx; font-weight: 650; }
.progress-number { font-size: 44rpx; font-weight: 800; }
.progress-line { height: 18rpx; overflow: hidden; border-radius: 999rpx; background: #e7ede7; margin-top: 16rpx; }
.progress-fill { height: 100%; border-radius: inherit; background: #347a5d; }
.summary-row { display: flex; align-items: stretch; gap: 12rpx; margin: 18rpx 0; }
.summary-row .regenerate { flex: 1; min-width: 0; height: 88rpx; padding: 0 16rpx; font-size: 23rpx; }
.stale-note { flex: 1; min-width: 0; display: flex; flex-direction: column; justify-content: center; background: #fff1cd; color: #a27426; border-radius: 22rpx; padding: 10rpx 18rpx; font-size: 21rpx; line-height: 1.5; }
.quick-add { display: flex; align-items: center; gap: 12rpx; padding: 12rpx; margin-bottom: 20rpx; }
.quick-plus { font-size: 40rpx; padding-left: 8rpx; }
.quick-add input { flex: 1; min-width: 0; height: 76rpx; font-size: 25rpx; }
.quick-add-button { display: flex; align-items: center; justify-content: center; width: 124rpx; height: 76rpx; padding: 0; flex: none; background: var(--ink); color: #fff; border-radius: 20rpx; font-size: 26rpx; }
.shopping-group { padding: 20rpx 24rpx 8rpx; margin-bottom: 18rpx; }
.group-heading { display: flex; align-items: center; gap: 10rpx; margin-bottom: 6rpx; }
.group-name { font-size: 28rpx; font-weight: 750; }
.shopping-item { display: flex; align-items: center; gap: 18rpx; min-height: 100rpx; border-top: 1rpx solid #e7eee5; }
.check-box { display: flex; justify-content: center; align-items: center; width: 40rpx; height: 40rpx; flex: none; border: 3rpx solid #98a59e; border-radius: 10rpx; color: #fff; font-size: 25rpx; font-weight: 700; }
.checked .check-box { background: var(--ink); border-color: var(--ink); }
.food-name { font-size: 28rpx; flex: 1; min-width: 0; overflow-wrap: anywhere; }
.checked .food-name { color: #98a29c; text-decoration: line-through; }
.checked kitchen-art { opacity: 0.55; }
.clear-button { border-color: #a4b1a8; color: var(--muted); }
.shopping-page .quick-add-button { width: 124rpx; min-width: 124rpx; max-width: 124rpx; flex: 0 0 124rpx; box-sizing: border-box; }
